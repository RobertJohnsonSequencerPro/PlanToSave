@page "/accounts"
@attribute [Authorize]
@inject IAccountService AccountService
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Accounts — PlanToSave</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Accounts</h1>
    <a href="/accounts/new" class="btn btn-primary">+ New Account</a>
</div>

@if (accounts is null)
{
    <p class="text-muted">Loading...</p>
}
else if (accounts.Count == 0)
{
    <div class="alert alert-info">
        No accounts yet. <a href="/accounts/new" class="alert-link">Create your first account →</a>
    </div>
}
else
{
    @* Stock Accounts *@
    var stockAccounts = accounts.Where(a => a.IsStockAccount).ToList();
    @if (stockAccounts.Any())
    {
        <h5 class="text-muted text-uppercase small fw-semibold mb-2 mt-4">Stock Accounts</h5>
        <div class="card mb-4">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Description</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in stockAccounts)
                        {
                            var isReconciling = reconcileAccountId == account.Id;
                            <tr>
                                <td class="fw-semibold">@account.Name</td>
                                <td><span class="badge @GetTypeBadgeClass(account.Type)">@account.Type</span></td>
                                <td class="text-muted small">@(account.Description ?? "—")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm @(isReconciling ? "btn-outline-secondary" : "btn-outline-primary") me-1"
                                            @onclick="() => ToggleReconcile(account.Id)">
                                        @(isReconciling ? "Cancel" : "Set Balance")
                                    </button>
                                    <a href="/accounts/@account.Id/edit" class="btn btn-sm btn-outline-secondary me-1">Edit</a>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => ArchiveAccount(account.Id, account.Name)">
                                        Archive
                                    </button>
                                </td>
                            </tr>
                            @if (isReconciling)
                            {
                                <tr class="table-light">
                                    <td colspan="4" class="px-4 py-3">
                                        <div class="d-flex flex-wrap gap-2 align-items-end">
                                            <div>
                                                <label class="form-label small mb-1 fw-semibold">Balance as of date</label>
                                                <InputDate @bind-Value="reconcileDate" class="form-control form-control-sm" style="width:160px" />
                                            </div>
                                            <div>
                                                <label class="form-label small mb-1 fw-semibold">Amount ($)</label>
                                                <InputNumber @bind-Value="reconcileAmount" class="form-control form-control-sm" style="width:140px" step="0.01" />
                                            </div>
                                            <div style="min-width:200px">
                                                <label class="form-label small mb-1 fw-semibold">Note <span class="fw-normal text-muted">(optional)</span></label>
                                                <InputText @bind-Value="reconcileNote" class="form-control form-control-sm" placeholder="e.g. Bank statement" />
                                            </div>
                                            <button class="btn btn-primary btn-sm" @onclick="() => SaveReconcile(account.Id)">Save</button>
                                        </div>
                                        <div class="text-muted small mt-2">
                                            This records the actual balance on that date. Flows logged <em>after</em> that date will be added/subtracted from this baseline.
                                        </div>
                                        @if (reconcileError is not null)
                                        {
                                            <div class="text-danger small mt-1">@reconcileError</div>
                                        }
                                        @if (reconcileVariance is not null)
                                        {
                                            var v = reconcileVariance.Value;
                                            var vClass = v == 0 ? "text-success" : (v > 0 ? "text-success" : "text-danger");
                                            var vSign  = v >= 0 ? "+" : "";
                                            var vLabel = v == 0
                                                ? "Perfect match — no discrepancy."
                                                : (v > 0
                                                    ? $"Bank balance is {v.ToString("C")} higher than the tracked running total."
                                                    : $"Bank balance is {Math.Abs(v).ToString("C")} lower than the tracked running total.");
                                            <div class="@vClass small mt-2 fw-semibold">Variance: @(vSign)@v.ToString("C") — @vLabel</div>
                                        }
                                        @if (snapshots.Count > 0)
                                        {
                                            <div class="mt-2">
                                                <span class="text-muted small fw-semibold">Past reconciliations:</span>
                                                @foreach (var s in snapshots.Take(3))
                                                {
                                                    var badgeVarianceClass = s.Variance == 0 ? "text-success" : (s.Variance > 0 ? "text-success" : "text-danger");
                                                    var badgeVarianceSign  = s.Variance >= 0 ? "+" : "";
                                                    <span class="badge bg-light text-dark border ms-1">
                                                        @s.EffectiveDate.ToString("MMM d, yyyy") → @s.Amount.ToString("C")
                                                        <span class="@badgeVarianceClass ms-1">(@(badgeVarianceSign)@s.Variance.ToString("C"))</span>
                                                        @if (s.Note is not null) { <text> @s.Note</text> }
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* Flow Accounts *@
    var flowAccounts = accounts.Where(a => !a.IsStockAccount).ToList();
    @if (flowAccounts.Any())
    {
        <h5 class="text-muted text-uppercase small fw-semibold mb-2 mt-4">Flow Accounts (Income &amp; Expense)</h5>
        <div class="card mb-4">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Description</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in flowAccounts)
                        {
                            <tr>
                                <td class="fw-semibold">@account.Name</td>
                                <td><span class="badge @GetTypeBadgeClass(account.Type)">@account.Type</span></td>
                                <td class="text-muted small">@(account.Description ?? "—")</td>
                                <td class="text-end">
                                    <a href="/accounts/@account.Id/edit" class="btn btn-sm btn-outline-secondary me-1">Edit</a>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => ArchiveAccount(account.Id, account.Name)">
                                        Archive
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* Archived accounts toggle *@
    <div class="mt-2">
        <button class="btn btn-link btn-sm text-muted p-0"
                @onclick="ToggleArchived">
            @(showArchived ? "Hide archived accounts" : "Show archived accounts")
        </button>
    </div>

    @if (showArchived)
    {
        var archived = accounts.Where(a => a.IsArchived).ToList();
        @if (archived.Any())
        {
            <div class="card mt-2 border-secondary">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0 text-muted">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var account in archived)
                            {
                                <tr>
                                    <td><s>@account.Name</s></td>
                                    <td><span class="badge bg-secondary">@account.Type</span></td>
                                    <td>@(account.Description ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <p class="text-muted small mt-2">No archived accounts.</p>
        }
    }
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible mt-3">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private List<AccountDto>? accounts;
    private string userId = "";
    private bool showArchived = false;
    private string? errorMessage;

    // Reconcile state
    private Guid? reconcileAccountId;
    private DateOnly reconcileDate = DateOnly.FromDateTime(DateTime.Today);
    private decimal reconcileAmount;
    private string? reconcileNote;
    private string? reconcileError;
    private decimal? reconcileVariance;
    private List<BalanceSnapshotDto> snapshots = [];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        await LoadAccounts();
    }

    private async Task LoadAccounts()
    {
        accounts = await AccountService.GetAccountsAsync(userId, includeArchived: true);
        if (!showArchived)
            accounts = accounts.Where(a => !a.IsArchived).ToList();
    }

    private async Task ToggleReconcile(Guid accountId)
    {
        if (reconcileAccountId == accountId)
        {
            reconcileAccountId = null;
            snapshots = [];
            reconcileError = null;
            reconcileVariance = null;
            return;
        }
        reconcileAccountId = accountId;
        reconcileDate = DateOnly.FromDateTime(DateTime.Today);
        reconcileAmount = 0;
        reconcileNote = null;
        reconcileError = null;
        reconcileVariance = null;
        snapshots = await AccountService.GetSnapshotsAsync(userId, accountId);
    }

    private async Task SaveReconcile(Guid accountId)
    {
        reconcileError = null;
        reconcileVariance = null;
        try
        {
            await AccountService.SetSnapshotAsync(userId, accountId, reconcileAmount, reconcileDate, reconcileNote);
            snapshots = await AccountService.GetSnapshotsAsync(userId, accountId);
            reconcileVariance = snapshots.FirstOrDefault(s => s.EffectiveDate == reconcileDate)?.Variance;
            reconcileNote = null;
        }
        catch (Exception ex)
        {
            reconcileError = ex.Message;
        }
    }

    private async Task ToggleArchived()
    {
        showArchived = !showArchived;
        await LoadAccounts();
    }

    private async Task ArchiveAccount(Guid id, string name)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Archive \"{name}\"? It will no longer appear in plans or the dashboard.");
        if (!confirmed) return;

        try
        {
            await AccountService.ArchiveAsync(id, userId);
            await LoadAccounts();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not archive account: {ex.Message}";
        }
    }

    private static string GetTypeBadgeClass(AccountType type) => type switch
    {
        AccountType.Income     => "bg-success",
        AccountType.Expense    => "bg-danger",
        AccountType.Checking   => "bg-primary",
        AccountType.Savings    => "bg-info text-dark",
        AccountType.Credit     => "bg-warning text-dark",
        AccountType.Investment => "bg-secondary",
        _                      => "bg-light text-dark"
    };
}
