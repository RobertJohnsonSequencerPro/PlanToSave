@page "/accounts"
@attribute [Authorize]
@inject IAccountService AccountService
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Accounts — PlanToSave</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Accounts</h1>
    <a href="/accounts/new" class="btn btn-primary">+ New Account</a>
</div>

@if (accounts is null)
{
    <p class="text-muted">Loading...</p>
}
else if (accounts.Count == 0)
{
    <div class="alert alert-info">
        No accounts yet. <a href="/accounts/new" class="alert-link">Create your first account →</a>
    </div>
}
else
{
    @* Stock Accounts *@
    var stockAccounts = accounts.Where(a => a.IsStockAccount).ToList();
    @if (stockAccounts.Any())
    {
        <h5 class="text-muted text-uppercase small fw-semibold mb-2 mt-4">Stock Accounts</h5>
        <div class="card mb-4">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Description</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in stockAccounts)
                        {
                            <tr>
                                <td class="fw-semibold">@account.Name</td>
                                <td><span class="badge @GetTypeBadgeClass(account.Type)">@account.Type</span></td>
                                <td class="text-muted small">@(account.Description ?? "—")</td>
                                <td class="text-end">
                                    <a href="/accounts/@account.Id/edit" class="btn btn-sm btn-outline-secondary me-1">Edit</a>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => ArchiveAccount(account.Id, account.Name)">
                                        Archive
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* Flow Accounts *@
    var flowAccounts = accounts.Where(a => !a.IsStockAccount).ToList();
    @if (flowAccounts.Any())
    {
        <h5 class="text-muted text-uppercase small fw-semibold mb-2 mt-4">Flow Accounts (Income &amp; Expense)</h5>
        <div class="card mb-4">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Description</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in flowAccounts)
                        {
                            <tr>
                                <td class="fw-semibold">@account.Name</td>
                                <td><span class="badge @GetTypeBadgeClass(account.Type)">@account.Type</span></td>
                                <td class="text-muted small">@(account.Description ?? "—")</td>
                                <td class="text-end">
                                    <a href="/accounts/@account.Id/edit" class="btn btn-sm btn-outline-secondary me-1">Edit</a>
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => ArchiveAccount(account.Id, account.Name)">
                                        Archive
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* Archived accounts toggle *@
    <div class="mt-2">
        <button class="btn btn-link btn-sm text-muted p-0"
                @onclick="ToggleArchived">
            @(showArchived ? "Hide archived accounts" : "Show archived accounts")
        </button>
    </div>

    @if (showArchived)
    {
        var archived = accounts.Where(a => a.IsArchived).ToList();
        @if (archived.Any())
        {
            <div class="card mt-2 border-secondary">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0 text-muted">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var account in archived)
                            {
                                <tr>
                                    <td><s>@account.Name</s></td>
                                    <td><span class="badge bg-secondary">@account.Type</span></td>
                                    <td>@(account.Description ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <p class="text-muted small mt-2">No archived accounts.</p>
        }
    }
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible mt-3">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private List<AccountDto>? accounts;
    private string userId = "";
    private bool showArchived = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        await LoadAccounts();
    }

    private async Task LoadAccounts()
    {
        accounts = await AccountService.GetAccountsAsync(userId, includeArchived: true);
        // Filter based on showArchived toggle — we load all so toggling is instant
        if (!showArchived)
            accounts = accounts.Where(a => !a.IsArchived).ToList();
    }

    private async Task ToggleArchived()
    {
        showArchived = !showArchived;
        await LoadAccounts();
    }

    private async Task ArchiveAccount(Guid id, string name)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Archive \"{name}\"? It will no longer appear in plans or the dashboard.");
        if (!confirmed) return;

        try
        {
            await AccountService.ArchiveAsync(id, userId);
            await LoadAccounts();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not archive account: {ex.Message}";
        }
    }

    private static string GetTypeBadgeClass(AccountType type) => type switch
    {
        AccountType.Income     => "bg-success",
        AccountType.Expense    => "bg-danger",
        AccountType.Checking   => "bg-primary",
        AccountType.Savings    => "bg-info text-dark",
        AccountType.Credit     => "bg-warning text-dark",
        AccountType.Investment => "bg-secondary",
        _                      => "bg-light text-dark"
    };
}
