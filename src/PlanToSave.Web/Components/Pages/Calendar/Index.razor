@page "/calendar"
@attribute [Authorize]
@inject IActivityPlanService ActivityPlanService
@inject IGoalService GoalService
@inject IMonthlyPlanService PlanService
@inject ICalendarEventService CalendarEventService
@inject AuthenticationStateProvider AuthState

<PageTitle>Calendar — PlanToSave</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Calendar</h1>
    <span class="text-muted small">Your activities at a glance</span>
</div>

@* Month navigation *@
<div class="d-flex align-items-center justify-content-between mb-3">
    <button class="btn btn-outline-secondary btn-sm" @onclick="PrevMonth">&#8249; Prev</button>
    <h5 class="mb-0 fw-semibold">@monthLabel</h5>
    <button class="btn btn-outline-secondary btn-sm" @onclick="NextMonth">Next &#8250;</button>
</div>

@* Day-of-week headers *@
<div class="cal-header">
    @foreach (var d in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
    {
        <div class="cal-header-cell">@d</div>
    }
</div>

@if (plans is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    @* Calendar cells *@
    <div class="cal-grid">
                        @foreach (var dayNum in calendarCells)
            {
                var evs        = dayNum > 0 && eventsByDay.ContainsKey(dayNum)   ? eventsByDay[dayNum]   : [];
                var goalEvs    = dayNum > 0 && goalsByDay.ContainsKey(dayNum)    ? goalsByDay[dayNum]    : [];
                var contribs   = dayNum > 0 && contribsByDay.ContainsKey(dayNum) ? contribsByDay[dayNum] : [];
                var customEvs  = dayNum > 0 && customByDay.ContainsKey(dayNum)   ? customByDay[dayNum]   : [];
                bool isToday = dayNum > 0 && dayNum == todayDay && year == todayYear && month == todayMonth;
                bool isSelected = dayNum > 0 && dayNum == selectedDay;
                int shownCount = Math.Min(evs.Count, 2) + Math.Min(goalEvs.Count, 1) + Math.Min(contribs.Count, 1) + Math.Min(customEvs.Count, 1);
                int totalCount = evs.Count + goalEvs.Count + contribs.Count + customEvs.Count;

                <div class="cal-cell @(dayNum == 0 ? "cal-empty" : "") @(isToday ? "cal-today" : "") @(isSelected ? "cal-selected" : "")"
                     @onclick="() => SelectDay(dayNum)">
                    @if (dayNum > 0)
                    {
                        <span class="cal-day-num @(isToday ? "cal-day-num-today" : "")">@dayNum</span>
                        @foreach (var ev in evs.Take(2))
                        {
                            <div class="cal-event @GetStatusClass(ev.Status)">@ev.IdeaTitle</div>
                        }
                        @foreach (var g in goalEvs.Take(1))
                        {
                            <div class="cal-event cal-event-goal">🎯 @g.Name</div>
                        }
                        @foreach (var c in contribs.Take(1))
                        {
                            <div class="cal-event cal-event-contrib">💰 @c.GoalName</div>
                        }
                        @foreach (var ce in customEvs.Take(1))
                        {
                            <div class="cal-event cal-event-custom">📌 @ce.Title</div>
                        }
                        @if (totalCount > shownCount)
                        {
                            <div class="cal-more">+@(totalCount - shownCount) more</div>
                        }
                    }
                </div>
            }
    </div>

    @if (selectedDay > 0)
    {
        var selectedDate   = new DateOnly(year, month, selectedDay);
        var selectedEvents = eventsByDay.TryGetValue(selectedDay, out var ae)   ? ae : [];
        var selectedGoals  = goalsByDay.TryGetValue(selectedDay, out var ag)    ? ag : [];
        var selectedContribs = contribsByDay.TryGetValue(selectedDay, out var ak) ? ak : [];
        var selectedCustom = customByDay.TryGetValue(selectedDay, out var ac)   ? ac : [];
        <div class="card mt-4 border-primary">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <span class="fw-semibold">@selectedDate.ToString("dddd, MMMM d, yyyy")</span>
                <div class="d-flex gap-2 align-items-center">
                    <button class="btn btn-outline-primary btn-sm" @onclick="ToggleAddForm">
                        @(showAddForm ? "✕ Cancel" : "+ Add event")
                    </button>
                    <button type="button" class="btn-close btn-sm" @onclick="() => selectedDay = 0"
                            aria-label="Close"></button>
                </div>
            </div>

            @if (showAddForm)
            {
                <div class="card-body border-bottom pb-3">
                    <EditForm Model="addEventForm" OnValidSubmit="SubmitAddEvent">
                        <DataAnnotationsValidator />
                        <div class="row g-2 align-items-end">
                            <div class="col-sm">
                                <label class="form-label fw-semibold mb-1 small">Title</label>
                                <InputText @bind-Value="addEventForm.Title" class="form-control form-control-sm"
                                           placeholder="e.g. Tuition due, Car insurance renewal" />
                                <ValidationMessage For="() => addEventForm.Title" class="text-danger small" />
                            </div>
                            <div class="col-sm-auto">
                                <label class="form-label fw-semibold mb-1 small">Date</label>
                                <InputDate @bind-Value="addEventForm.Date" class="form-control form-control-sm" />
                            </div>
                            <div class="col-sm">
                                <label class="form-label fw-semibold mb-1 small">Notes <span class="text-muted fw-normal">(optional)</span></label>
                                <InputText @bind-Value="addEventForm.Notes" class="form-control form-control-sm"
                                           placeholder="Optional note" />
                            </div>
                            <div class="col-sm-auto">
                                <button type="submit" class="btn btn-primary btn-sm">Save</button>
                            </div>
                        </div>
                        @if (addEventError is not null)
                        {
                            <div class="alert alert-danger py-1 small mt-2">@addEventError</div>
                        }
                    </EditForm>
                </div>
            }

            @if (selectedEvents.Count == 0 && selectedGoals.Count == 0 && selectedCustom.Count == 0 && selectedContribs.Count == 0 && !showAddForm)
            {
                <div class="card-body text-center text-muted small py-3">
                    Nothing scheduled on @selectedDate.ToString("MMMM d"). Click "+ Add event" to note something.
                </div>
            }

            <ul class="list-group list-group-flush">
                @foreach (var ev in selectedEvents)
                {
                    <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
                        <div>
                            <span class="badge @GetStatusBadge(ev.Status) me-2">@ev.Status</span>
                            <a href="/upcoming/@ev.Id" class="fw-semibold text-decoration-none">@ev.IdeaTitle</a>
                            @if (!string.IsNullOrWhiteSpace(ev.Notes))
                            {
                                <div class="text-muted small mt-1">@ev.Notes</div>
                            }
                        </div>
                        <AddToCalendarButton Title="@ev.IdeaTitle" Date="@ev.PlannedDate" Notes="@ev.Notes" />
                    </li>
                }
                @foreach (var g in selectedGoals)
                {
                    var pct = g.TargetAmount > 0
                        ? Math.Min(100, (int)Math.Round(g.SavedAmount / g.TargetAmount * 100))
                        : 0;
                    <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
                        <div>
                            <span class="badge bg-warning text-dark me-2">🎯 Goal</span>
                            <a href="/goals" class="fw-semibold text-decoration-none">@g.Name</a>
                            <div class="text-muted small mt-1">@g.SavedAmount.ToString("C") of @g.TargetAmount.ToString("C") (@pct%)</div>
                        </div>
                        <AddToCalendarButton Title="@($"Goal: {g.Name}")" Date="@g.TargetDate" Notes="@g.Description" />
                    </li>
                }
                @foreach (var ce in selectedCustom)
                {
                    <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
                        <div>
                            <span class="badge bg-info text-dark me-2">📌 Note</span>
                            <span class="fw-semibold">@ce.Title</span>
                            @if (!string.IsNullOrWhiteSpace(ce.Notes))
                            {
                                <div class="text-muted small mt-1">@ce.Notes</div>
                            }
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <AddToCalendarButton Title="@ce.Title" Date="@ce.Date" Notes="@ce.Notes" />
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteCustomEvent(ce.Id)"
                                    title="Delete event" aria-label="Delete event">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                    <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                                </svg>
                            </button>
                        </div>
                    </li>
                }
                @foreach (var c in selectedContribs)
                {
                    <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
                        <div>
                            <span class="badge bg-success me-2">💰 Goal Contribution</span>
                            <a href="/goals" class="fw-semibold text-decoration-none">@c.GoalName</a>
                            <div class="text-muted small mt-1">
                                @c.Amount.ToString("C") from @c.FromAccountName → @c.ToAccountName
                                @if (!string.IsNullOrWhiteSpace(c.Description))
                                {
                                    <span class="ms-1">— @c.Description</span>
                                }
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </div>
    }
}

@code {
    private List<ActivityPlanDto>? plans;
    private List<GoalDto> goalsAll = [];
    private List<GoalContributionDto> goalContribs = [];
    private List<CalendarEventDto> customEvents = [];
    private string userId = "";

    private int year, month, selectedDay;
    private List<int> calendarCells = [];
    private Dictionary<int, List<ActivityPlanDto>> eventsByDay = new();
    private Dictionary<int, List<GoalDto>> goalsByDay = new();
    private Dictionary<int, List<GoalContributionDto>> contribsByDay = new();
    private Dictionary<int, List<CalendarEventDto>> customByDay = new();

    private bool showAddForm;
    private CreateCalendarEventDto addEventForm = new();
    private string? addEventError;

    private static readonly int todayYear = DateTime.Today.Year;
    private static readonly int todayMonth = DateTime.Today.Month;
    private static readonly int todayDay = DateTime.Today.Day;

    private string monthLabel => new DateTime(year, month, 1).ToString("MMMM yyyy");

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        year  = DateTime.Today.Year;
        month = DateTime.Today.Month;
        await LoadMonth();
    }

    private async Task LoadMonth()
    {
        plans        = await ActivityPlanService.GetPlansForMonthAsync(userId, year, month);
        goalsAll     = await GoalService.GetGoalsAsync(userId);
        goalContribs = await PlanService.GetGoalContributionsForMonthAsync(userId, year, month);
        customEvents = await CalendarEventService.GetForMonthAsync(userId, year, month);
        BuildGrid();
    }

    private void BuildGrid()
    {
        selectedDay = 0;
        showAddForm = false;
        eventsByDay = plans!
            .Where(p => p.PlannedDate.HasValue)
            .GroupBy(p => p.PlannedDate!.Value.Day)
            .ToDictionary(g => g.Key, g => g.ToList());

        goalsByDay = goalsAll
            .Where(g => !g.IsComplete && g.TargetDate.Year == year && g.TargetDate.Month == month)
            .GroupBy(g => g.TargetDate.Day)
            .ToDictionary(g => g.Key, g => g.ToList());

        // Goal contributions have no specific day — show them on day 1 of the month
        contribsByDay = goalContribs.Count > 0
            ? new Dictionary<int, List<GoalContributionDto>> { [1] = goalContribs }
            : new();

        customByDay = customEvents
            .GroupBy(e => e.Date.Day)
            .ToDictionary(g => g.Key, g => g.ToList());

        int startOffset = (int)new DateTime(year, month, 1).DayOfWeek;
        int daysInMonth = DateTime.DaysInMonth(year, month);
        int totalCells  = (int)Math.Ceiling((startOffset + daysInMonth) / 7.0) * 7;

        calendarCells = Enumerable.Range(0, totalCells)
            .Select(i => { int d = i - startOffset + 1; return d >= 1 && d <= daysInMonth ? d : 0; })
            .ToList();
    }

    private void SelectDay(int day)
    {
        if (day == 0) return;
        if (selectedDay == day)
        {
            selectedDay = 0;
            showAddForm = false;
        }
        else
        {
            selectedDay  = day;
            showAddForm  = false;
            addEventForm = new CreateCalendarEventDto { Date = new DateOnly(year, month, day) };
            addEventError = null;
        }
    }

    private void ToggleAddForm()
    {
        showAddForm   = !showAddForm;
        addEventError = null;
        if (showAddForm)
            addEventForm = new CreateCalendarEventDto { Date = new DateOnly(year, month, selectedDay) };
    }

    private async Task SubmitAddEvent()
    {
        try
        {
            await CalendarEventService.CreateAsync(userId, addEventForm);
            showAddForm  = false;
            addEventError = null;
            await LoadMonth();
            selectedDay = addEventForm.Date.Day;
        }
        catch (Exception ex)
        {
            addEventError = ex.Message;
        }
    }

    private async Task DeleteCustomEvent(Guid id)
    {
        try
        {
            await CalendarEventService.DeleteAsync(userId, id);
            var day = selectedDay;
            await LoadMonth();
            selectedDay = day;
        }
        catch { /* ignore */ }
    }

    private async Task PrevMonth()
    {
        var dt = new DateTime(year, month, 1).AddMonths(-1);
        year = dt.Year; month = dt.Month;
        await LoadMonth();
    }

    private async Task NextMonth()
    {
        var dt = new DateTime(year, month, 1).AddMonths(1);
        year = dt.Year; month = dt.Month;
        await LoadMonth();
    }

    private static string GetStatusClass(ActivityPlanStatus s) => s switch
    {
        ActivityPlanStatus.Done    => "cal-event-done",
        ActivityPlanStatus.Skipped => "cal-event-skipped",
        _                          => "cal-event-upcoming"
    };

    private static string GetStatusBadge(ActivityPlanStatus s) => s switch
    {
        ActivityPlanStatus.Done    => "bg-success",
        ActivityPlanStatus.Skipped => "bg-secondary",
        _                          => "bg-primary"
    };
}
