@page "/review"
@attribute [Authorize]
@inject IActivityReviewService ReviewService
@inject IActualFlowService FlowService
@inject AuthenticationStateProvider AuthState

<PageTitle>Review — PlanToSave</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Review</h1>
    <span class="text-muted small">Close the loop on past activities</span>
</div>

@* Log-as-expense follow-up prompt *@
@if (loggingPlanId.HasValue)
{
    <div class="card border-success mb-4">
        <div class="card-header bg-success text-white fw-semibold">
            ✓ Review saved — log this as an expense?
        </div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                You spent <strong>@logForm.Amount.ToString("C")</strong> on <strong>@logIdeaTitle</strong>.
                Want to record it as an actual transaction?
            </p>
            <EditForm Model="logForm" OnValidSubmit="SubmitLogExpense">
                <DataAnnotationsValidator />
                <div class="row g-2 mb-2">
                    <div class="col-sm">
                        <label class="form-label fw-semibold small mb-1">From account</label>
                        <InputSelect @bind-Value="logForm.FromAccountId" class="form-select form-select-sm">
                            <option value="">-- select --</option>
                            @foreach (var a in fromOptions)
                            {
                                <option value="@a.Id">@a.Name (@a.Type)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-sm">
                        <label class="form-label fw-semibold small mb-1">To account</label>
                        <InputSelect @bind-Value="logForm.ToAccountId" class="form-select form-select-sm">
                            <option value="">-- select --</option>
                            @foreach (var a in toOptions)
                            {
                                <option value="@a.Id">@a.Name (@a.Type)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-sm-auto">
                        <label class="form-label fw-semibold small mb-1">Amount</label>
                        <div class="input-group input-group-sm log-expense-amount">
                            <span class="input-group-text">$</span>
                            <InputNumber @bind-Value="logForm.Amount" class="form-control" />
                        </div>
                        <ValidationMessage For="() => logForm.Amount" class="text-danger small" />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label fw-semibold small mb-1">Description <span class="text-muted fw-normal">(optional)</span></label>
                    <InputText @bind-Value="logForm.Description" class="form-control form-control-sm" />
                </div>
                @if (logError is not null)
                {
                    <div class="alert alert-danger py-1 small">@logError</div>
                }
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success btn-sm">Log expense</button>
                    <button type="button" class="btn btn-link btn-sm p-0" @onclick="SkipLogExpense">Skip</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (plans is null)
{
    <p class="text-muted">Loading...</p>
}
else if (plans.Count == 0)
{
    <div class="card text-center py-5">
        <div class="card-body text-muted">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="mb-3 text-muted" viewBox="0 0 16 16">
                <path d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425a.247.247 0 0 1 .02-.022z"/>
            </svg>
            <p class="mb-1 fw-semibold">All caught up!</p>
            <p class="mb-0 small">No activities are waiting for a review.</p>
            <div class="mt-3">
                <a href="/upcoming" class="btn btn-secondary btn-sm">View upcoming plans</a>
            </div>
        </div>
    </div>
}
else
{
    <p class="text-muted mb-4">
        @plans.Count @(plans.Count == 1 ? "activity needs" : "activities need") your attention. Did these happen?
    </p>

    @foreach (var plan in plans)
    {
        var isExpanded = expandedId == plan.Id;
        var isSkipping = skippingId == plan.Id;
        <div class="card mb-3 @(isExpanded || isSkipping ? "border-primary" : "border-warning")">
            <div class="card-body">
                @* Header row *@
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="badge bg-secondary me-1 small">@plan.IdeaCategory</span>
                        <h5 class="mb-0 d-inline fw-semibold">@plan.IdeaTitle</h5>
                    </div>
                    <span class="text-danger small fw-semibold">
                        @plan.PlannedDate!.Value.ToString("MMM d, yyyy")
                    </span>
                </div>
                @if (!string.IsNullOrWhiteSpace(plan.Notes))
                {
                    <p class="text-muted small mb-2">@plan.Notes</p>
                }

                @if (!isExpanded && !isSkipping)
                {
                    @* Decision buttons *@
                    <div class="d-flex gap-2 mt-2">
                        <button class="btn btn-success btn-sm" @onclick="() => StartReview(plan.Id)">
                            &#10003; Yes, I did it!
                        </button>
                        <button class="btn btn-secondary btn-sm" @onclick="() => StartSkip(plan.Id)">
                            &#10007; Didn't happen
                        </button>
                    </div>
                }

                @if (isExpanded)
                {
                    @* Review form *@
                    <hr class="my-3" />
                    <EditForm Model="reviewForm" OnValidSubmit="() => SubmitReview(plan.Id)">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label fw-semibold">How would you rate it?</label>
                            <div class="d-flex gap-2">
                                @for (int star = 1; star <= 5; star++)
                                {
                                    var s = star; // capture for closure
                                    <button type="button"
                                            class="btn btn-sm star-btn @(reviewForm.Rating == s ? "btn-warning" : "btn-secondary")"
                                            @onclick="() => reviewForm.Rating = s"
                                            aria-label="Rate @s star(s)">
                                        ★
                                    </button>
                                }
                                @if (reviewForm.Rating.HasValue)
                                {
                                    <span class="align-self-center text-muted small ms-2">@reviewForm.Rating/5</span>
                                }
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Reflection <span class="text-muted fw-normal">(optional)</span></label>
                            <InputTextArea @bind-Value="reviewForm.Reflection" class="form-control" rows="3"
                                           placeholder="What did you enjoy? What would you do differently?" />
                            <ValidationMessage For="() => reviewForm.Reflection" class="text-danger small" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Actual cost <span class="text-muted fw-normal">(optional)</span></label>
                            <div class="input-group actual-cost-amount">
                                <span class="input-group-text">$</span>
                                <InputNumber @bind-Value="reviewForm.ActualAmount" class="form-control" placeholder="0.00" />
                            </div>
                            <ValidationMessage For="() => reviewForm.ActualAmount" class="text-danger small" />
                        </div>
                        @if (submitError is not null)
                        {
                            <div class="alert alert-danger py-2 small">@submitError</div>
                        }
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success btn-sm">Save review</button>
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="CancelAction">Cancel</button>
                        </div>
                    </EditForm>
                }

                @if (isSkipping)
                {
                    @* Skip confirmation *@
                    <hr class="my-3" />
                    <p class="text-muted small mb-3">
                        This will mark the plan as skipped and return <strong>@plan.IdeaTitle</strong> to your backlog so you can reschedule it.
                    </p>
                    @if (submitError is not null)
                    {
                        <div class="alert alert-danger py-2 small">@submitError</div>
                    }
                    <div class="d-flex gap-2">
                        <button class="btn btn-secondary btn-sm" @onclick="() => ConfirmSkip(plan.Id)">Confirm skip</button>
                        <button class="btn btn-link btn-sm p-0" @onclick="CancelAction">Cancel</button>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private List<ActivityPlanDto>? plans;
    private string userId = "";

    private Guid? expandedId;
    private Guid? skippingId;
    private SubmitReviewDto reviewForm = new();
    private string? submitError;

    // Log-as-transaction state
    private Guid? loggingPlanId;
    private string logIdeaTitle = "";
    private CreateActualFlowDto logForm = new();
    private string? logError;
    private List<AccountOptionDto> fromOptions = [];
    private List<AccountOptionDto> toOptions = [];

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        await LoadPlans();
    }

    private async Task LoadPlans()
    {
        plans = await ReviewService.GetNeedsReviewAsync(userId);
    }

    private void StartReview(Guid id)
    {
        expandedId  = id;
        skippingId  = null;
        reviewForm  = new SubmitReviewDto();
        submitError = null;
    }

    private void StartSkip(Guid id)
    {
        skippingId  = id;
        expandedId  = null;
        submitError = null;
    }

    private void CancelAction()
    {
        expandedId  = null;
        skippingId  = null;
        submitError = null;
    }

    private async Task SubmitReview(Guid planId)
    {
        try
        {
            var plan = plans!.First(p => p.Id == planId);
            await ReviewService.SubmitAsync(userId, planId, reviewForm);
            expandedId  = null;
            submitError = null;

            if (reviewForm.ActualAmount is > 0)
            {
                // Load account options lazily
                if (fromOptions.Count == 0)
                {
                    fromOptions = await FlowService.GetFromAccountOptionsAsync(userId);
                    toOptions   = await FlowService.GetToAccountOptionsAsync(userId);
                }

                logIdeaTitle = plan.IdeaTitle;
                logForm = new CreateActualFlowDto
                {
                    Amount      = reviewForm.ActualAmount.Value,
                    Date        = DateOnly.FromDateTime(DateTime.Today),
                    Description = plan.IdeaTitle
                };
                logError       = null;
                loggingPlanId  = planId;
                await LoadPlans(); // reload list (plan is now Done so it'll disappear)
            }
            else
            {
                await LoadPlans();
            }
        }
        catch (Exception ex)
        {
            submitError = ex.Message;
        }
    }

    private async Task SubmitLogExpense()
    {
        if (logForm.FromAccountId == Guid.Empty || logForm.ToAccountId == Guid.Empty)
        {
            logError = "Please select both From and To accounts.";
            return;
        }
        try
        {
            await FlowService.CreateAsync(userId, logForm);
            loggingPlanId = null;
            logError      = null;
        }
        catch (Exception ex)
        {
            logError = ex.Message;
        }
    }

    private void SkipLogExpense()
    {
        loggingPlanId = null;
        logError      = null;
    }

    private async Task ConfirmSkip(Guid planId)
    {
        try
        {
            await ReviewService.SkipAsync(userId, planId);
            skippingId  = null;
            submitError = null;
            await LoadPlans();
        }
        catch (Exception ex)
        {
            submitError = ex.Message;
        }
    }
}
