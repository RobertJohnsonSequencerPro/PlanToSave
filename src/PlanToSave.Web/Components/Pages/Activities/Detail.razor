@page "/upcoming/{Id:guid}"
@attribute [Authorize]
@inject IActivityPlanService ActivityPlanService
@inject IMonthlyPlanService PlanService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>@(plan?.IdeaTitle ?? "Plan Detail") — PlanToSave</PageTitle>

@if (plan is null)
{
    <p class="text-muted mt-4">Loading...</p>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/upcoming">Upcoming Plans</a></li>
            <li class="breadcrumb-item active">@plan.IdeaTitle</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="mb-0">@plan.IdeaTitle</h1>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge @GetCategoryBadge(plan.IdeaCategory)">@plan.IdeaCategory</span>
                @if (plan.PlannedDate.HasValue)
                {
                    var today = DateOnly.FromDateTime(DateTime.Today);
                    bool overdue = plan.PlannedDate.Value < today;
                    <span class="small @(overdue ? "text-danger fw-semibold" : "text-muted")">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                            <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                        </svg>
                        @plan.PlannedDate.Value.ToString("MMMM d, yyyy")
                        @if (overdue) { <span> · overdue</span> }
                    </span>
                }
                else
                {
                    <span class="text-muted small">TBD — no date set</span>
                }
            </div>
        </div>
        <button class="btn btn-sm btn-outline-danger" title="Delete plan" aria-label="Delete plan" @onclick="DeletePlan">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
            </svg>
        </button>
    </div>

    @if (plan.PlannedDate.HasValue)
    {
        <div class="mb-3">
            <AddToCalendarButton Title="@plan.IdeaTitle" Date="@plan.PlannedDate" Notes="@plan.Notes" />
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(plan.Notes))
    {
        <div class="alert alert-secondary py-2 mb-3 small">
            <strong>Notes:</strong> @plan.Notes
        </div>
    }

    @* Budget section *@
    <div class="card mb-4">
        <div class="card-header py-2 d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Budget</span>
            @if (plan.PlannedFlowId.HasValue)
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="UnlinkBudget">Unlink</button>
            }
        </div>
        @if (plan.PlannedFlowId.HasValue)
        {
            <div class="card-body py-2">
                <div class="d-flex flex-wrap gap-3 align-items-center">
                    <div>
                        <span class="text-muted small">Planned:</span>
                        <span class="fw-semibold ms-1">@plan.BudgetAmount?.ToString("C")</span>
                        @if (!string.IsNullOrWhiteSpace(plan.BudgetDescription))
                        {
                            <span class="text-muted small ms-2">(@plan.BudgetDescription)</span>
                        }
                    </div>
                    @if (linkedActualAmount.HasValue)
                    {
                        <div>
                            <span class="text-muted small">Actual:</span>
                            <span class="fw-semibold ms-1 @(linkedActualAmount.Value <= (plan.BudgetAmount ?? 0) ? "text-success" : "text-danger")">
                                @linkedActualAmount.Value.ToString("C")
                            </span>
                        </div>
                    }
                    @if (plan.BudgetYear.HasValue && plan.BudgetMonth.HasValue)
                    {
                        <a href="/plans/@plan.BudgetYear/@plan.BudgetMonth" class="btn btn-sm btn-outline-primary">
                            View @(new DateTime(plan.BudgetYear.Value, plan.BudgetMonth.Value, 1).ToString("MMMM yyyy")) plan
                        </a>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="card-body py-2">
                @if (!showBudgetPicker)
                {
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => showBudgetPicker = true">
                        + Link to a budget line
                    </button>
                }
                else
                {
                    <div>
                        <div class="row g-2 align-items-end mb-2">
                            <div class="col-auto">
                                <label class="form-label form-label-sm mb-1">Year</label>
                                <input type="number" class="form-control form-control-sm budget-year-input"
                                       @bind="budgetPickerYear" min="2020" max="2099" />
                            </div>
                            <div class="col-auto">
                                <label class="form-label form-label-sm mb-1">Month</label>
                                <select class="form-select form-select-sm budget-month-select" @bind="budgetPickerMonth">
                                    @foreach (var m in Enumerable.Range(1, 12))
                                    {
                                        <option value="@m">@(new DateTime(2000, m, 1).ToString("MMMM"))</option>
                                    }
                                </select>
                            </div>
                            <div class="col-auto">
                                <button class="btn btn-sm btn-secondary" @onclick="LoadBudgetPickerFlows"
                                        disabled="@loadingBudgetFlows">
                                    @(loadingBudgetFlows ? "Loading…" : "Load flows")
                                </button>
                            </div>
                        </div>
                        @if (budgetPickerPlan is not null)
                        {
                            @if (budgetPickerPlan.PlannedFlows.Count == 0)
                            {
                                <p class="text-muted small mb-2">No planned transactions exist for that month.</p>
                            }
                            else
                            {
                                <div class="row g-2 align-items-end mb-2">
                                    <div class="col-auto">
                                        <label class="form-label form-label-sm mb-1">Budget line</label>
                                        <select class="form-select form-select-sm" @bind="budgetPickerFlowId">
                                            <option value="@Guid.Empty">— select —</option>
                                            @foreach (var pf in budgetPickerPlan.PlannedFlows)
                                            {
                                                var label = $"{pf.FromAccountName} → {pf.ToAccountName}  {pf.PlannedAmount:C}" +
                                                            (pf.Description is not null ? $"  ({pf.Description})" : "");
                                                <option value="@pf.Id">@label</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-auto">
                                        <button class="btn btn-sm btn-primary" @onclick="LinkBudget"
                                                disabled="@(budgetPickerFlowId == Guid.Empty)">
                                            Link
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                        @if (budgetError is not null)
                        {
                            <div class="text-danger small mt-1">@budgetError</div>
                        }
                        <button class="btn btn-sm btn-link p-0 text-muted" @onclick="() => { showBudgetPicker = false; budgetError = null; }">
                            Cancel
                        </button>
                    </div>
                }
            </div>
        }
    </div>

    @* Progress summary *@
    int pct = plan.TotalSteps > 0 ? (int)Math.Round((double)plan.CompletedSteps / plan.TotalSteps * 100) : 0;
    string progressClass = pct >= 100 ? "bg-success" : "bg-primary";
    <div class="d-flex justify-content-between align-items-center text-muted small mb-1">
        <span>Progress</span>
        <span>@plan.CompletedSteps / @plan.TotalSteps steps complete · @pct%</span>
    </div>
    <div class="progress mb-4 progress-md">
        <div class="progress-bar @progressClass" style="width: @pct%"
             role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
    </div>

    @* Steps checklist *@
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center py-2">
            <span class="fw-semibold">Steps</span>
            <span class="text-muted small">@plan.CompletedSteps / @plan.TotalSteps complete</span>
        </div>

        @if (plan.Steps.Count == 0)
        {
            <div class="card-body text-muted small">
                No steps yet. Use the field below to break this activity into manageable pieces.
            </div>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var step in plan.Steps)
                {
                    <li class="list-group-item d-flex align-items-center gap-2 py-2">
                        <input type="checkbox" class="form-check-input mt-0 flex-shrink-0"
                               checked="@step.IsComplete"
                               @onchange="() => ToggleStep(step.Id)" />
                        <span class="flex-grow-1 @(step.IsComplete ? "text-decoration-line-through text-muted" : "")">
                            @step.Title
                        </span>
                        <button class="btn btn-sm btn-link text-danger p-0 flex-shrink-0"
                                @onclick="() => DeleteStep(step.Id)" title="Delete step" aria-label="Delete step">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                            </svg>
                        </button>
                    </li>
                }
            </ul>
        }

        <div class="card-footer">
            <div class="input-group input-group-sm">
                <input type="text" class="form-control" placeholder="Add a step…"
                       @bind="newStepTitle" @bind:event="oninput"
                       @onkeydown="OnStepKeyDown" />
                <button class="btn btn-primary" @onclick="AddStep"
                        disabled="@(string.IsNullOrWhiteSpace(newStepTitle))">
                    Add
                </button>
            </div>
            @if (stepError is not null)
            {
                <div class="text-danger small mt-1">@stepError</div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ActivityPlanDto? plan;
    private string userId = "";
    private string newStepTitle = "";
    private string? stepError;

    // Budget linking state
    private bool showBudgetPicker;
    private int budgetPickerYear;
    private int budgetPickerMonth;
    private MonthlyPlanDetailDto? budgetPickerPlan;
    private Guid budgetPickerFlowId = Guid.Empty;
    private bool loadingBudgetFlows;
    private string? budgetError;
    private decimal? linkedActualAmount;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        plan = await ActivityPlanService.GetPlanAsync(userId, Id);

        // Default budget picker to the activity's planned month (or today)
        var refDate = plan?.PlannedDate?.ToDateTime(TimeOnly.MinValue) ?? DateTime.Today;
        budgetPickerYear = refDate.Year;
        budgetPickerMonth = refDate.Month;

        // If already linked, load the actual spend from the monthly plan
        if (plan?.PlannedFlowId.HasValue == true && plan.BudgetYear.HasValue && plan.BudgetMonth.HasValue)
        {
            var monthPlan = await PlanService.GetPlanDetailAsync(userId, plan.BudgetYear.Value, plan.BudgetMonth.Value);
            var linkedFlow = monthPlan?.PlannedFlows.FirstOrDefault(pf => pf.Id == plan.PlannedFlowId);
            linkedActualAmount = linkedFlow?.ActualAmount;
        }
    }

    private async Task LoadBudgetPickerFlows()
    {
        loadingBudgetFlows = true;
        budgetPickerPlan = null;
        budgetPickerFlowId = Guid.Empty;
        budgetError = null;
        try
        {
            budgetPickerPlan = await PlanService.GetPlanDetailAsync(userId, budgetPickerYear, budgetPickerMonth);
        }
        finally
        {
            loadingBudgetFlows = false;
        }
    }

    private async Task LinkBudget()
    {
        if (budgetPickerFlowId == Guid.Empty) return;
        budgetError = null;
        try
        {
            await ActivityPlanService.LinkBudgetAsync(userId, Id, budgetPickerFlowId);
            plan = await ActivityPlanService.GetPlanAsync(userId, Id);
            showBudgetPicker = false;
            budgetPickerPlan = null;
            if (plan?.BudgetYear.HasValue == true && plan.BudgetMonth.HasValue)
            {
                var monthPlan = await PlanService.GetPlanDetailAsync(userId, plan.BudgetYear.Value, plan.BudgetMonth.Value);
                var linkedFlow = monthPlan?.PlannedFlows.FirstOrDefault(pf => pf.Id == plan.PlannedFlowId);
                linkedActualAmount = linkedFlow?.ActualAmount;
            }
        }
        catch (Exception ex)
        {
            budgetError = ex.Message;
        }
    }

    private async Task UnlinkBudget()
    {
        await ActivityPlanService.LinkBudgetAsync(userId, Id, null);
        plan = await ActivityPlanService.GetPlanAsync(userId, Id);
        linkedActualAmount = null;
    }

    private async Task AddStep()
    {
        if (string.IsNullOrWhiteSpace(newStepTitle)) return;
        try
        {
            await ActivityPlanService.AddStepAsync(userId, Id, newStepTitle.Trim());
            newStepTitle = "";
            stepError = null;
            plan = await ActivityPlanService.GetPlanAsync(userId, Id);
        }
        catch (Exception ex)
        {
            stepError = ex.Message;
        }
    }

    private async Task OnStepKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddStep();
    }

    private async Task ToggleStep(Guid stepId)
    {
        await ActivityPlanService.ToggleStepAsync(userId, stepId);
        plan = await ActivityPlanService.GetPlanAsync(userId, Id);
    }

    private async Task DeleteStep(Guid stepId)
    {
        await ActivityPlanService.DeleteStepAsync(userId, stepId);
        plan = await ActivityPlanService.GetPlanAsync(userId, Id);
    }

    private async Task DeletePlan()
    {
        await ActivityPlanService.DeleteAsync(userId, Id);
        Nav.NavigateTo("/upcoming");
    }

    private static string GetCategoryBadge(IdeaCategory c) => c switch
    {
        IdeaCategory.Entertainment => "bg-primary",
        IdeaCategory.Travel        => "bg-info text-dark",
        IdeaCategory.Dining        => "bg-warning text-dark",
        IdeaCategory.Social        => "bg-danger",
        IdeaCategory.Wellness      => "bg-success",
        IdeaCategory.Learning      => "bg-secondary",
        _                          => "bg-secondary"
    };
}
