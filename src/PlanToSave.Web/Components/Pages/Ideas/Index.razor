@page "/ideas"
@attribute [Authorize]
@inject IIdeaService IdeaService
@inject IActivityPlanService ActivityPlanService
@inject AuthenticationStateProvider AuthState

<PageTitle>My Ideas — PlanToSave</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-1">
    <div>
        <h1 class="h3 mb-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="me-2 text-warning align-text-bottom" viewBox="0 0 16 16">
                <path d="M2 6a6 6 0 1 1 10.174 4.31c-.203.196-.359.4-.453.619l-.762 1.769A.5.5 0 0 1 10.5 13a.5.5 0 0 1 0 1 .5.5 0 0 1 0 1l-.224.447a1 1 0 0 1-.894.553H6.618a1 1 0 0 1-.894-.553L5.5 15a.5.5 0 0 1 0-1 .5.5 0 0 1 0-1 .5.5 0 0 1-.46-.302l-.761-1.77a1.964 1.964 0 0 0-.453-.618A5.984 5.984 0 0 1 2 6zm6-5a5 5 0 0 0-3.479 8.592c.263.254.514.564.676.941L5.83 12h4.342l.632-1.467c.162-.377.413-.687.676-.941A5 5 0 0 0 8 1z"/>
            </svg>
            My Ideas
        </h1>
        <p class="text-muted small mb-0">Browse, filter, and manage your activity backlog.</p>
    </div>
    <button class="btn btn-primary" @onclick="ToggleAddForm">
        @(showAddForm ? "Cancel" : "+ Add Idea")
    </button>
</div>

@if (showAddForm)
{
    <div class="card mt-3 mb-2">
        <div class="card-body">
            <h6 class="card-subtitle mb-3 text-muted">Capture a fun activity you'd like to do someday.</h6>
            <EditForm Model="newIdea" OnValidSubmit="SaveIdea">
                <DataAnnotationsValidator />
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label">Title <span class="text-danger">*</span></label>
                        <InputText @bind-Value="newIdea.Title" class="form-control" placeholder="e.g. Kayaking at Lake Union" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Description <span class="text-muted small">(optional)</span></label>
                        <InputText @bind-Value="newIdea.Description" class="form-control" placeholder="Any extra notes..." />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Category</label>
                        <InputSelect @bind-Value="newIdea.Category" class="form-select">
                            @foreach (var v in Enum.GetValues<IdeaCategory>())
                            {
                                <option value="@v">@v</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Energy Level</label>
                        <InputSelect @bind-Value="newIdea.EnergyLevel" class="form-select">
                            @foreach (var v in Enum.GetValues<IdeaEnergyLevel>())
                            {
                                <option value="@v">@v</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Cost Estimate</label>
                        <InputSelect @bind-Value="newIdea.CostEstimate" class="form-select">
                            @foreach (var v in Enum.GetValues<IdeaCostEstimate>())
                            {
                                <option value="@v">@v</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Est. Amount <span class="text-muted small">(optional)</span></label>
                        <InputNumber @bind-Value="newIdea.EstimatedAmount" class="form-control" placeholder="0.00" min="0" step="0.01" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Tags <span class="text-muted small">(optional)</span></label>
                        <InputText @bind-Value="newIdea.Tags" class="form-control" placeholder="summer, weekend, outdoors  (comma-separated)" />
                        <div class="form-text">Optional — used for filtering later.</div>
                    </div>
                </div>
                <ValidationSummary class="text-danger mt-2" />
                @if (formError is not null)
                {
                    <div class="text-danger mt-2 small">@formError</div>
                }
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary btn-sm">&#10003; Save Idea</button>
                    <button type="button" class="btn btn-link btn-sm" @onclick="ToggleAddForm">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Filter bar -->
<div class="card mb-3 mt-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small mb-1">Category</label>
                <select class="form-select form-select-sm" style="min-width:120px" @bind="filterCategory">
                    <option value="">All</option>
                    @foreach (var v in Enum.GetValues<IdeaCategory>())
                    {
                        <option value="@v">@v</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-1">Energy</label>
                <select class="form-select form-select-sm" style="min-width:100px" @bind="filterEnergy">
                    <option value="">All</option>
                    @foreach (var v in Enum.GetValues<IdeaEnergyLevel>())
                    {
                        <option value="@v">@v</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-1">Cost</label>
                <select class="form-select form-select-sm" style="min-width:110px" @bind="filterCost">
                    <option value="">All</option>
                    @foreach (var v in Enum.GetValues<IdeaCostEstimate>())
                    {
                        <option value="@v">@v</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-1">Status</label>
                <select class="form-select form-select-sm" style="min-width:110px" @bind="filterStatus">
                    <option value="">All</option>
                    @foreach (var v in Enum.GetValues<IdeaStatus>())
                    {
                        <option value="@v">@v</option>
                    }
                </select>
            </div>
            <div class="col">
                <label class="form-label small mb-1">Tag</label>
                <input type="text" class="form-control form-control-sm" @bind="filterTag" placeholder="e.g. summer" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary btn-sm" @onclick="ApplyFilter">Filter</button>
                <button class="btn btn-outline-secondary btn-sm ms-1" @onclick="ClearFilter">Clear</button>
            </div>
        </div>
    </div>
</div>

@if (ideas is null)
{
    <p class="text-muted">Loading...</p>
}
else if (ideas.Count == 0)
{
    <div class="card text-center py-5">
        <div class="card-body text-muted">
            @if (HasActiveFilter)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="mb-3 text-muted" viewBox="0 0 16 16">
                    <path d="M6 10.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5zm-2-3a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zm-2-3a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5z"/>
                </svg>
                <p class="mb-1 fw-semibold">No ideas match those filters.</p>
                <p class="mb-2 small">Try broadening your search or clearing the filters.</p>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilter">Clear filters</button>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="mb-3 text-primary" viewBox="0 0 16 16">
                    <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
                </svg>
                <h5 class="fw-semibold mb-1">Your idea backlog is empty</h5>
                <p class="mb-3 small">This is where you collect activities and experiences you want to have — restaurants to try, trips to take, skills to learn. Start dreaming!</p>
                <button class="btn btn-primary" @onclick="ToggleAddForm">+ Add your first idea</button>
            }
        </div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-1">
            <thead>
                <tr class="small text-uppercase text-muted">
                    <th>Title</th>
                    <th>Category</th>
                    <th>Energy</th>
                    <th>Cost</th>
                    <th>Status</th>
                    <th>Tags</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var idea in ideas)
                {
                    <tr>
                        <td class="fw-semibold">
                            @idea.Title
                            @if (idea.Description is not null)
                            {
                                <div class="text-muted small fw-normal">@idea.Description</div>
                            }
                        </td>
                        <td><span class="badge @GetCategoryBadge(idea.Category)">@idea.Category.ToString().ToLower()</span></td>
                        <td><span class="badge @GetEnergyBadge(idea.EnergyLevel)">@idea.EnergyLevel.ToString().ToLower()</span></td>
                        <td><span class="badge @GetCostBadge(idea.CostEstimate)">@idea.CostEstimate.ToString().ToLower()</span></td>
                        <td><span class="badge @GetStatusBadge(idea.Status)">@idea.Status.ToString().ToLower()</span></td>
                        <td class="text-muted small">@idea.Tags</td>
                        <td class="text-end">
                            @if (idea.Status == IdeaStatus.Backlog)
                            {
                                <button class="btn btn-sm btn-outline-primary me-1"
                                        @onclick="() => StartPlanThis(idea.Id, idea.Title)"
                                        title="Schedule this idea">
                                    Plan This
                                </button>
                            }
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteIdea(idea.Id)" title="Delete" aria-label="Delete idea">
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                    <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                                </svg>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="text-muted small">@ideas.Count idea(s) found.</div>
    </div>

    @* Inline schedule form — appears when Plan This is clicked *@
    @if (planningIdeaId.HasValue)
    {
        <div class="card mt-3 border-primary">
            <div class="card-body">
                <h6 class="card-subtitle mb-1 text-muted">Schedule:</h6>
                <p class="fw-semibold mb-3">@planningIdeaTitle</p>
                <EditForm Model="planForm" OnValidSubmit="SavePlan">
                    <DataAnnotationsValidator />
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label">Date <span class="text-muted small">(leave blank for TBD)</span></label>
                            <InputDate @bind-Value="planForm.PlannedDate" class="form-control" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Notes <span class="text-muted small">(optional)</span></label>
                            <InputText @bind-Value="planForm.Notes" class="form-control" placeholder="Any notes for this activity..." />
                        </div>
                    </div>
                    <ValidationSummary class="text-danger mt-2" />
                    @if (planError is not null)
                    {
                        <div class="text-danger mt-2 small">@planError</div>
                    }
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary btn-sm">&#10003; Schedule It</button>
                        <button type="button" class="btn btn-link btn-sm" @onclick="CancelPlanThis">Cancel</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
}

@code {
    private List<IdeaDto>? ideas;
    private string userId = "";
    private bool showAddForm = false;
    private SaveIdeaDto newIdea = new();
    private string? formError;

    // Filter state
    private string filterCategory = "";
    private string filterEnergy = "";
    private string filterCost = "";
    private string filterStatus = "";
    private string filterTag = "";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        await LoadIdeas();
    }

    private async Task LoadIdeas()
    {
        ideas = await IdeaService.GetIdeasAsync(userId, BuildFilter());
    }

    private IdeaFilterDto BuildFilter() => new()
    {
        Category     = string.IsNullOrEmpty(filterCategory) ? null : Enum.Parse<IdeaCategory>(filterCategory),
        EnergyLevel  = string.IsNullOrEmpty(filterEnergy)   ? null : Enum.Parse<IdeaEnergyLevel>(filterEnergy),
        CostEstimate = string.IsNullOrEmpty(filterCost)     ? null : Enum.Parse<IdeaCostEstimate>(filterCost),
        Status       = string.IsNullOrEmpty(filterStatus)   ? null : Enum.Parse<IdeaStatus>(filterStatus),
        Tag          = string.IsNullOrWhiteSpace(filterTag)  ? null : filterTag.Trim()
    };

    private bool HasActiveFilter =>
        !string.IsNullOrEmpty(filterCategory) || !string.IsNullOrEmpty(filterEnergy) ||
        !string.IsNullOrEmpty(filterCost)     || !string.IsNullOrEmpty(filterStatus) ||
        !string.IsNullOrWhiteSpace(filterTag);

    private async Task ApplyFilter() => await LoadIdeas();

    private async Task ClearFilter()
    {
        filterCategory = filterEnergy = filterCost = filterStatus = filterTag = "";
        await LoadIdeas();
    }

    private void ToggleAddForm()
    {
        showAddForm = !showAddForm;
        if (showAddForm)
        {
            newIdea = new SaveIdeaDto();
            formError = null;
        }
    }

    private async Task SaveIdea()
    {
        try
        {
            await IdeaService.CreateAsync(userId, newIdea);
            await LoadIdeas();
            showAddForm = false;
            formError = null;
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
    }

    private async Task DeleteIdea(Guid id)
    {
        await IdeaService.DeleteAsync(userId, id);
        await LoadIdeas();
    }

    private static string GetCategoryBadge(IdeaCategory c) => c switch
    {
        IdeaCategory.Entertainment => "bg-primary",
        IdeaCategory.Travel        => "bg-info text-dark",
        IdeaCategory.Dining        => "bg-warning text-dark",
        IdeaCategory.Social        => "bg-danger",
        IdeaCategory.Wellness      => "bg-success",
        IdeaCategory.Learning      => "bg-secondary",
        _                          => "bg-secondary"
    };

    private static string GetEnergyBadge(IdeaEnergyLevel e) => e switch
    {
        IdeaEnergyLevel.Low    => "bg-success",
        IdeaEnergyLevel.Medium => "bg-warning text-dark",
        IdeaEnergyLevel.High   => "bg-danger",
        _                      => "bg-secondary"
    };

    private static string GetCostBadge(IdeaCostEstimate c) => c switch
    {
        IdeaCostEstimate.Free      => "bg-success",
        IdeaCostEstimate.Cheap     => "bg-success",
        IdeaCostEstimate.Moderate  => "bg-warning text-dark",
        IdeaCostEstimate.Expensive => "bg-danger",
        _                          => "bg-secondary"
    };

    private static string GetStatusBadge(IdeaStatus s) => s switch
    {
        IdeaStatus.Backlog => "bg-secondary",
        IdeaStatus.Planned => "bg-primary",
        IdeaStatus.Done    => "bg-success",
        IdeaStatus.Skipped => "bg-dark",
        _                  => "bg-secondary"
    };

    // ─── Plan This ────────────────────────────────────────────────────────────
    private Guid? planningIdeaId;
    private string planningIdeaTitle = "";
    private CreateActivityPlanDto planForm = new();
    private string? planError;

    private void StartPlanThis(Guid id, string title)
    {
        planningIdeaId    = id;
        planningIdeaTitle = title;
        planForm          = new CreateActivityPlanDto();
        planError         = null;
        showAddForm       = false; // close the add-idea form if open
    }

    private void CancelPlanThis() => planningIdeaId = null;

    private async Task SavePlan()
    {
        if (!planningIdeaId.HasValue) return;
        try
        {
            await ActivityPlanService.CreateAsync(userId, planningIdeaId.Value, planForm);
            planningIdeaId = null;
            planError      = null;
            await LoadIdeas(); // refresh so Status badge updates
        }
        catch (Exception ex)
        {
            planError = ex.Message;
        }
    }
}
