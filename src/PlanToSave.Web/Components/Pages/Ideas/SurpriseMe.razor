@page "/surprise"
@attribute [Authorize]
@inject IIdeaService IdeaService
@inject IActivityPlanService ActivityPlanService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Surprise Me! — PlanToSave</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-1">
    <div>
        <h1 class="h3 mb-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="me-2 text-warning align-text-bottom" viewBox="0 0 16 16">
                <path d="M11.534 7h3.932a.25.25 0 0 1 .192.41l-1.966 2.36a.25.25 0 0 1-.384 0l-1.966-2.36a.25.25 0 0 1 .192-.41zm-11 2h3.932a.25.25 0 0 0 .192-.41L2.692 6.23a.25.25 0 0 0-.384 0L.342 8.59A.25.25 0 0 0 .534 9z"/>
                <path fill-rule="evenodd" d="M8 3c-1.552 0-2.94.707-3.857 1.818a.5.5 0 1 1-.771-.636A6.002 6.002 0 0 1 13.917 7H12.9A5.002 5.002 0 0 0 8 3zM3.1 9a5.002 5.002 0 0 0 8.757 2.182.5.5 0 1 1 .771.636A6.002 6.002 0 0 1 2.083 9H3.1z"/>
            </svg>
            Surprise Me!
        </h1>
        <p class="text-muted small mb-0">Fight decision paralysis — we'll pick something from your backlog.</p>
    </div>
</div>

@* Optional filters *@
<div class="card mt-3 mb-4">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small mb-1">Energy level</label>
                <select class="form-select form-select-sm" style="min-width:110px" @bind="filterEnergy">
                    <option value="">Any</option>
                    @foreach (var v in Enum.GetValues<IdeaEnergyLevel>())
                    {
                        <option value="@v">@v</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-1">Cost</label>
                <select class="form-select form-select-sm" style="min-width:110px" @bind="filterCost">
                    <option value="">Any</option>
                    @foreach (var v in Enum.GetValues<IdeaCostEstimate>())
                    {
                        <option value="@v">@v</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-warning btn-sm fw-semibold" @onclick="Spin" disabled="@spinning">
                    🎲 Pick for me!
                </button>
            </div>
        </div>
    </div>
</div>

@if (spinning)
{
    <p class="text-muted">Finding something fun…</p>
}
else if (notFound)
{
    <div class="card text-center py-5">
        <div class="card-body text-muted">
            <p class="mb-1">No backlog ideas match those filters.</p>
            <p class="mb-3 small">Try broader filters, or <a href="/ideas">add more ideas</a>.</p>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ResetFilters">Clear filters and try again</button>
        </div>
    </div>
}
else if (result is not null)
{
    <div class="card border-warning shadow-sm">
        <div class="card-header bg-warning bg-opacity-10 d-flex justify-content-between align-items-center py-2">
            <span class="fw-semibold text-warning">✨ How about this?</span>
            <button class="btn btn-sm btn-link p-0 text-muted" @onclick="Spin">🎲 Pick another</button>
        </div>
        <div class="card-body">
            <h3 class="card-title mb-1">@result.Title</h3>
            @if (!string.IsNullOrWhiteSpace(result.Description))
            {
                <p class="text-muted mb-3">@result.Description</p>
            }

            <div class="d-flex flex-wrap gap-2 mb-3">
                <span class="badge @GetCategoryBadge(result.Category)">@result.Category</span>
                <span class="badge @GetEnergyBadge(result.EnergyLevel)">@result.EnergyLevel energy</span>
                <span class="badge @GetCostBadge(result.CostEstimate)">@result.CostEstimate</span>
                @if (result.EstimatedAmount.HasValue)
                {
                    <span class="badge bg-light text-dark border">~@result.EstimatedAmount.Value.ToString("C0")</span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(result.Tags))
            {
                <p class="text-muted small mb-3">🏷️ @result.Tags</p>
            }

            @* Plan This inline form *@
            @if (!showPlanForm)
            {
                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary" @onclick="() => showPlanForm = true">
                        📅 Plan This
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="Spin">
                        🎲 Pick another
                    </button>
                    <a href="/ideas" class="btn btn-link">Browse all ideas →</a>
                </div>
            }
            else
            {
                <hr class="my-3" />
                <h6 class="mb-3">Schedule it</h6>
                <EditForm Model="planForm" OnValidSubmit="SavePlan">
                    <DataAnnotationsValidator />
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label">Date <span class="text-muted small">(leave blank for TBD)</span></label>
                            <InputDate @bind-Value="planForm.PlannedDate" class="form-control" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Notes <span class="text-muted small">(optional)</span></label>
                            <InputText @bind-Value="planForm.Notes" class="form-control" placeholder="Any notes for this activity..." />
                        </div>
                    </div>
                    <ValidationSummary class="text-danger mt-2" />
                    @if (planError is not null)
                    {
                        <div class="text-danger small mt-2">@planError</div>
                    }
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm">✓ Schedule It</button>
                        <button type="button" class="btn btn-link btn-sm" @onclick="() => showPlanForm = false">Cancel</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
}
else
{
    @* Initial state — show cta *@
    <div class="card text-center py-5">
        <div class="card-body">
            <div class="display-4 mb-3">🎲</div>
            <h4>Ready to be surprised?</h4>
            <p class="text-muted mb-4">We'll pick a random idea from your backlog. Use the filters above to narrow it down by energy level or cost.</p>
            <button class="btn btn-warning btn-lg fw-semibold" @onclick="Spin">Pick for me!</button>
        </div>
    </div>
}

@code {
    private string userId = "";
    private string filterEnergy = "";
    private string filterCost   = "";
    private IdeaDto? result;
    private bool spinning  = false;
    private bool notFound  = false;
    private bool showPlanForm = false;
    private CreateActivityPlanDto planForm = new();
    private string? planError;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
    }

    private async Task Spin()
    {
        spinning     = true;
        notFound     = false;
        result       = null;
        showPlanForm = false;
        planError    = null;
        StateHasChanged();

        var energy = string.IsNullOrEmpty(filterEnergy) ? (IdeaEnergyLevel?)null : Enum.Parse<IdeaEnergyLevel>(filterEnergy);
        var cost   = string.IsNullOrEmpty(filterCost)   ? (IdeaCostEstimate?)null : Enum.Parse<IdeaCostEstimate>(filterCost);

        result   = await IdeaService.GetRandomBacklogIdeaAsync(userId, energy, cost);
        notFound = result is null;
        spinning = false;
    }

    private async Task ResetFilters()
    {
        filterEnergy = "";
        filterCost   = "";
        await Spin();
    }

    private async Task SavePlan()
    {
        if (result is null) return;
        try
        {
            await ActivityPlanService.CreateAsync(userId, result.Id, planForm);
            Nav.NavigateTo("/upcoming");
        }
        catch (Exception ex)
        {
            planError = ex.Message;
        }
    }

    private static string GetCategoryBadge(IdeaCategory c) => c switch
    {
        IdeaCategory.Entertainment => "bg-primary",
        IdeaCategory.Travel        => "bg-info text-dark",
        IdeaCategory.Dining        => "bg-warning text-dark",
        IdeaCategory.Social        => "bg-danger",
        IdeaCategory.Wellness      => "bg-success",
        IdeaCategory.Learning      => "bg-secondary",
        _                          => "bg-secondary"
    };

    private static string GetEnergyBadge(IdeaEnergyLevel e) => e switch
    {
        IdeaEnergyLevel.Low    => "bg-success",
        IdeaEnergyLevel.Medium => "bg-warning text-dark",
        IdeaEnergyLevel.High   => "bg-danger",
        _                      => "bg-secondary"
    };

    private static string GetCostBadge(IdeaCostEstimate c) => c switch
    {
        IdeaCostEstimate.Free      => "bg-success",
        IdeaCostEstimate.Cheap     => "bg-success",
        IdeaCostEstimate.Moderate  => "bg-warning text-dark",
        IdeaCostEstimate.Expensive => "bg-danger",
        _                          => "bg-secondary"
    };
}
