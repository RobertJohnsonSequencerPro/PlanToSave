@page "/goals"
@attribute [Authorize]
@inject IGoalService GoalService
@inject IAccountService AccountService
@inject IIdeaService IdeaService
@inject IMonthlyPlanService PlanService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthState

<PageTitle>Goals</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Goals</h1>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" @onclick="OpenAccountModal">+ New Account</button>
        <button class="btn btn-primary" @onclick="ToggleAddForm">
            @(showAddForm ? "Cancel" : "+ New Goal")
        </button>
    </div>
</div>

@if (showScheduleModal && scheduleGoal is not null)
{
    var remaining = Math.Max(0, scheduleGoal.TargetAmount - scheduleGoal.SavedAmount);
    var totalMonths = scheduleMonths;
    var preview = totalMonths > 0 ? scheduleDto.MonthlyAmount * totalMonths : 0;
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Generate Contribution Schedule — @scheduleGoal.Name</h5>
                    <button type="button" class="btn-close" @onclick="CloseScheduleModal"></button>
                </div>
                <EditForm Model="scheduleDto" OnValidSubmit="SaveSchedule">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="alert alert-info py-2 mb-3 small">
                            Remaining to save: <strong>@remaining.ToString("C")</strong>
                            @if (scheduleGoal.SavedAmount > 0)
                            {
                                <span class="text-muted ms-2">(@scheduleGoal.SavedAmount.ToString("C") already saved of @scheduleGoal.TargetAmount.ToString("C") target)</span>
                            }
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-sm-4">
                                <label class="form-label fw-semibold">Monthly amount</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <InputNumber @bind-Value="scheduleDto.MonthlyAmount" class="form-control" step="0.01" min="0.01" />
                                </div>
                                <ValidationMessage For="() => scheduleDto.MonthlyAmount" class="text-danger small" />
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label fw-semibold">Start month</label>
                                <input type="month" class="form-control"
                                       value="@($"{scheduleDto.StartYear:D4}-{scheduleDto.StartMonth:D2}")"
                                       min="@($"{DateTime.Today.Year:D4}-{DateTime.Today.Month:D2}")"
                                       @onchange="e => ParseMonthInput(e.Value?.ToString(), isStart: true)" />
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label fw-semibold">End month</label>
                                <input type="month" class="form-control"
                                       value="@($"{scheduleDto.EndYear:D4}-{scheduleDto.EndMonth:D2}")"
                                       min="@($"{scheduleDto.StartYear:D4}-{scheduleDto.StartMonth:D2}")"
                                       @onchange="e => ParseMonthInput(e.Value?.ToString(), isStart: false)" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Description <span class="fw-normal text-muted">(optional)</span></label>
                            <InputText @bind-Value="scheduleDto.Description" class="form-control"
                                       placeholder="@($"{scheduleGoal.Name} — contribution")" />
                        </div>

                        <div class="form-check mb-3">
                            <InputCheckbox @bind-Value="scheduleDto.ReplaceExisting" class="form-check-input" id="replaceChk" />
                            <label class="form-check-label" for="replaceChk">
                                Replace existing planned contributions for this goal
                            </label>
                            <div class="form-text">If unchecked, new entries are added alongside any that already exist.</div>
                        </div>

                        @if (scheduleMonths > 0)
                        {
                            <div class="alert @(preview >= remaining ? "alert-success" : "alert-warning") py-2 small">
                                This will create <strong>@scheduleMonths monthly contribution@(scheduleMonths == 1 ? "" : "s")</strong>
                                of <strong>@scheduleDto.MonthlyAmount.ToString("C")</strong>
                                from <strong>@(new DateOnly(scheduleDto.StartYear, scheduleDto.StartMonth, 1).ToString("MMM yyyy"))</strong>
                                to <strong>@(new DateOnly(scheduleDto.EndYear, scheduleDto.EndMonth, 1).ToString("MMM yyyy"))</strong>,
                                totalling <strong>@preview.ToString("C")</strong>.
                                @if (preview < remaining)
                                {
                                    <span class="text-warning"> That is @((remaining - preview).ToString("C")) short of the remaining target.</span>
                                }
                                else
                                {
                                    <span class="text-success"> That covers the remaining target.</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-danger py-1 small mt-1">End month must be the same as or after the start month.</div>
                        }

                        @if (scheduleError is not null)
                        {
                            <div class="alert alert-danger py-1 small mt-1">@scheduleError</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseScheduleModal">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@(scheduleMonths <= 0 || savingSchedule)">
                            @if (savingSchedule) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Create @scheduleMonths month@(scheduleMonths == 1 ? "" : "s")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (showAccountModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">New Account or Category</h5>
                    <button type="button" class="btn-close" @onclick="CloseAccountModal"></button>
                </div>
                <EditForm Model="newAccount" OnValidSubmit="SaveNewAccount">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Account Name</label>
                            <InputText @bind-Value="newAccount.Name" class="form-control" placeholder="e.g. Main Checking" />
                            <ValidationMessage For="() => newAccount.Name" class="text-danger small" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Account Type</label>
                            <InputSelect @bind-Value="newAccount.Type" class="form-select">
                                @foreach (var t in Enum.GetValues<AccountType>())
                                {
                                    <option value="@t">@t</option>
                                }
                            </InputSelect>
                            <div class="form-text text-muted">@GetAccountTypeHint(newAccount.Type)</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Description <span class="fw-normal text-muted">(optional)</span>
                            </label>
                            <InputText @bind-Value="newAccount.Description" class="form-control"
                                       placeholder="e.g. Joint account at First National Bank" />
                        </div>
                        @if (newAccount.Type is AccountType.Checking or AccountType.Savings
                                             or AccountType.Credit or AccountType.Investment)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Opening Balance <span class="fw-normal text-muted">(optional)</span>
                                </label>
                                <div class="input-group opening-balance-input">
                                    <span class="input-group-text">$</span>
                                    <InputNumber @bind-Value="newAccount.OpeningBalance" class="form-control" step="0.01" />
                                </div>
                                <ValidationMessage For="() => newAccount.OpeningBalance" class="text-danger small" />
                            </div>
                        }
                        @if (accountSaveError is not null)
                        {
                            <div class="alert alert-danger py-1 small mt-1">@accountSaveError</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseAccountModal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Account</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (showAddForm)
{
    <div class="card mb-4">
        <div class="card-body">
            <h6 class="card-subtitle mb-3 text-muted">New Goal</h6>
            <EditForm Model="newGoal" OnValidSubmit="CreateGoal">
                <DataAnnotationsValidator />
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label">Goal Name</label>
                        <InputText @bind-Value="newGoal.Name" class="form-control" placeholder="e.g. Emergency Fund" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Description <span class="text-muted">(optional)</span></label>
                        <InputText @bind-Value="newGoal.Description" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Target Account <span class="text-muted small">(save into)</span></label>
                        <InputSelect @bind-Value="newGoal.TargetAccountId" class="form-select">
                            <option value="@Guid.Empty">— select —</option>
                            @foreach (var a in stockAccounts)
                            {
                                <option value="@a.Id">@a.Name (@a.Type)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Source Account <span class="text-muted small">(fund from)</span></label>
                        <InputSelect @bind-Value="newGoal.SourceAccountId" class="form-select">
                            <option value="@Guid.Empty">— select —</option>
                            @foreach (var a in stockAccounts)
                            {
                                <option value="@a.Id">@a.Name (@a.Type)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Target Amount</label>
                        <InputNumber @bind-Value="newGoal.TargetAmount" class="form-control" min="0.01" step="0.01" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Start Date</label>
                        <InputDate @bind-Value="newGoal.StartDate" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Target Date</label>
                        <InputDate @bind-Value="newGoal.TargetDate" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Saving toward an idea? <span class="text-muted small">(optional)</span></label>
                        <InputSelect @bind-Value="newGoal.IdeaId" class="form-select">
                            <option value="@Guid.Empty">— none —</option>
                            @foreach (var idea in backlogIdeas)
                            {
                                <option value="@idea.Id">@idea.Title</option>
                            }
                        </InputSelect>
                        <div class="form-text">Links this goal to a backlog idea so you can track progress together.</div>
                    </div>
                </div>
                <ValidationSummary class="text-danger mt-2" />
                @if (formError is not null)
                {
                    <div class="alert alert-danger mt-3">@formError</div>
                }
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary btn-sm">Save Goal</button>
                    <button type="button" class="btn btn-link btn-sm" @onclick="ToggleAddForm">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (initError is not null)
{
    <div class="alert alert-danger">
        <strong>Error loading goals:</strong> @initError
    </div>
}
else if (goals is null)
{
    <p class="text-muted">Loading...</p>
}
else if (goals.Count == 0)
{
    <div class="card text-center py-5">
        <div class="card-body text-muted">
            <p class="mb-2">No goals yet.</p>
            <p>Goals track your progress toward a savings target in a specific account.</p>
        </div>
    </div>
}
else
{
    <div class="mb-3 d-flex gap-2">
        <button class="btn btn-sm @(showComplete == false ? "btn-primary" : "btn-secondary")"
                @onclick="() => showComplete = false">
            Active (@goals.Count(g => !g.IsComplete))
        </button>
        <button class="btn btn-sm @(showComplete == true ? "btn-success" : "btn-secondary")"
                @onclick="() => showComplete = true">
            Completed (@goals.Count(g => g.IsComplete))
        </button>
    </div>

    @foreach (var goal in goals.Where(g => g.IsComplete == showComplete))
    {
        var pct = goal.TargetAmount > 0
            ? Math.Min(100, (int)Math.Round(goal.SavedAmount / goal.TargetAmount * 100))
            : 0;
        var today = DateOnly.FromDateTime(DateTime.Today);
        var daysLeft = goal.TargetDate.DayNumber - today.DayNumber;
        var progressClass = pct >= 100 ? "bg-success" : (daysLeft < 30 ? "bg-warning" : "bg-primary");
        var monthlyNeeded = goal.TargetAmount > goal.SavedAmount && daysLeft > 0
            ? (goal.TargetAmount - goal.SavedAmount) / Math.Max(1, (decimal)daysLeft / 30.44m)
            : 0m;

        <div class="card mb-3 @(goal.IsComplete ? "border-success" : "")">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h5 class="card-title mb-0">
                            @if (goal.IsComplete)
                            {
                                <span class="badge bg-success me-2">✓ Complete</span>
                            }
                            @goal.Name
                        </h5>
                        @if (goal.IdeaTitle is not null)
                        {
                            <p class="text-muted small mb-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" fill="currentColor" class="me-1 text-warning" viewBox="0 0 16 16">
                                    <path d="M2 6a6 6 0 1 1 10.174 4.31c-.203.196-.359.4-.453.619l-.762 1.769A.5.5 0 0 1 10.5 13a.5.5 0 0 1 0 1 .5.5 0 0 1 0 1l-.224.447a1 1 0 0 1-.894.553H6.618a1 1 0 0 1-.894-.553L5.5 15a.5.5 0 0 1 0-1 .5.5 0 0 1 0-1 .5.5 0 0 1-.46-.302l-.761-1.77a1.964 1.964 0 0 0-.453-.618A5.984 5.984 0 0 1 2 6zm6-5a5 5 0 0 0-3.479 8.592c.263.254.514.564.676.941L5.83 12h4.342l.632-1.467c.162-.377.413-.687.676-.941A5 5 0 0 0 8 1z"/>
                                </svg>
                                Saving for: <a href="/ideas" class="text-decoration-none">@goal.IdeaTitle</a>
                            </p>
                        }
                        else if (goal.Description is not null)
                        {
                            <p class="text-muted small mb-0">@goal.Description</p>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        @if (!goal.IsComplete)
                        {
                            <button class="btn btn-sm btn-primary"
                                    @onclick="() => OpenScheduleModal(goal)">
                                Generate Schedule
                            </button>
                        }
                        <button class="btn btn-sm @(goal.IsComplete ? "btn-secondary" : "btn-success")"
                                @onclick="() => ToggleComplete(goal.Id)">
                            @(goal.IsComplete ? "Reopen" : "Mark Complete")
                        </button>
                        <button class="btn btn-sm btn-danger" title="Delete" aria-label="Delete goal"
                                @onclick="() => DeleteGoal(goal.Id, goal.Name)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="row g-2 mb-3 text-center">
                    <div class="col-6 col-sm-3">
                        <div class="text-muted small">Saved</div>
                        <div class="fw-bold">@goal.SavedAmount.ToString("C")</div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="text-muted small">Target</div>
                        <div class="fw-bold">@goal.TargetAmount.ToString("C")</div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="text-muted small">Target Date</div>
                        <div class="fw-bold">
                            @goal.TargetDate.ToString("MMM d, yyyy")
                            @if (!goal.IsComplete)
                            {
                                <span class="d-block small @(daysLeft < 0 ? "text-danger" : daysLeft < 30 ? "text-warning" : "text-muted")">
                                    @(daysLeft < 0 ? Math.Abs(daysLeft) + "d overdue" : daysLeft + "d left")
                                </span>
                            }
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="text-muted small">Target Account</div>
                        <div class="fw-semibold small">@goal.TargetAccountName</div>
                    </div>
                </div>

                <div class="progress progress-lg">
                    <div class="progress-bar @progressClass"
                         role="progressbar"
                         style="width: @pct%"
                         aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                        @pct%
                    </div>
                </div>

                @if (!goal.IsComplete && monthlyNeeded > 0)
                {
                    <div class="text-muted small mt-1 text-end">
                        ~@monthlyNeeded.ToString("C") / month needed to reach goal on time
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private List<GoalDto>? goals;
    private List<AccountDto> stockAccounts = [];
    private List<IdeaDto> backlogIdeas = [];
    private string userId = "";
    private bool showAddForm = false;
    private CreateGoalDto newGoal = new();
    private string? formError;
    private bool showComplete = false;
    private string? initError;

    // Account modal
    private bool showAccountModal = false;
    private CreateAccountDto newAccount = new();
    private string? accountSaveError;

    // Schedule modal
    private bool showScheduleModal = false;
    private bool savingSchedule = false;
    private GoalDto? scheduleGoal;
    private GenerateGoalScheduleDto scheduleDto = new();
    private string? scheduleError;
    private int scheduleMonths => ScheduleMonthCount();

    private int ScheduleMonthCount()
    {
        try
        {
            var start = new DateOnly(scheduleDto.StartYear, scheduleDto.StartMonth, 1);
            var end   = new DateOnly(scheduleDto.EndYear,   scheduleDto.EndMonth,   1);
            if (end < start) return 0;
            return (end.Year - start.Year) * 12 + (end.Month - start.Month) + 1;
        }
        catch { return 0; }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        try
        {
            goals         = await GoalService.GetGoalsAsync(userId);
            var accounts  = await AccountService.GetAccountsAsync(userId);
            stockAccounts = accounts.Where(a => a.IsStockAccount && !a.IsArchived).ToList();
            backlogIdeas  = await IdeaService.GetIdeasAsync(userId,
                new IdeaFilterDto { Status = IdeaStatus.Backlog });

            // Pre-open form if navigated from Ideas page with ?ideaId=
            var rawQuery = new Uri(NavigationManager.Uri).Query.TrimStart('?');
            foreach (var segment in rawQuery.Split('&', StringSplitOptions.RemoveEmptyEntries))
            {
                var eq = segment.IndexOf('=');
                if (eq > 0
                    && segment[..eq].Equals("ideaId", StringComparison.OrdinalIgnoreCase)
                    && Guid.TryParse(Uri.UnescapeDataString(segment[(eq + 1)..]), out var preId)
                    && backlogIdeas.Any(i => i.Id == preId))
                {
                    showAddForm = true;
                    newGoal.IdeaId = preId;
                    break;
                }
            }
        }
        catch (Exception ex)
        {
            initError = ex.ToString();
        }
    }

    private void ToggleAddForm()
    {
        showAddForm = !showAddForm;
        if (showAddForm)
        {
            newGoal = new CreateGoalDto();
            formError = null;
        }
    }

    private async Task CreateGoal()
    {
        if (newGoal.TargetAccountId == Guid.Empty || newGoal.SourceAccountId == Guid.Empty)
        {
            formError = "Please select both Target and Source accounts.";
            return;
        }
        if (newGoal.TargetDate <= newGoal.StartDate)
        {
            formError = "Target date must be after start date.";
            return;
        }
        try
        {
            await GoalService.CreateAsync(userId, newGoal);
            goals = await GoalService.GetGoalsAsync(userId);
            showAddForm = false;
            formError = null;
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
    }

    private async Task ToggleComplete(Guid id)
    {
        await GoalService.MarkCompleteAsync(userId, id);
        goals = await GoalService.GetGoalsAsync(userId);
    }

    private async Task DeleteGoal(Guid id, string name)
    {
        await GoalService.DeleteAsync(userId, id);
        goals = await GoalService.GetGoalsAsync(userId);
    }

    private void OpenAccountModal()
    {
        newAccount = new CreateAccountDto();
        accountSaveError = null;
        showAccountModal = true;
    }

    private void CloseAccountModal() => showAccountModal = false;

    private async Task SaveNewAccount()
    {
        try
        {
            await AccountService.CreateAsync(userId, newAccount);
            var allAccounts = await AccountService.GetAccountsAsync(userId);
            stockAccounts = allAccounts.Where(a => a.IsStockAccount && !a.IsArchived).ToList();
            showAccountModal = false;
        }
        catch (Exception ex)
        {
            accountSaveError = ex.Message;
        }
    }

    private static string GetAccountTypeHint(AccountType type) => type switch
    {
        AccountType.Checking   => "Everyday spending account with a running balance.",
        AccountType.Savings    => "Savings account that earns interest.",
        AccountType.Credit     => "Credit card or line of credit.",
        AccountType.Investment => "Brokerage or investment account.",
        AccountType.Income     => "An income source (salary, freelance, etc.) — no balance tracked.",
        AccountType.Expense    => "A spending category (groceries, utilities, dining, etc.) — no balance tracked.",
        _                      => ""
    };

    private void OpenScheduleModal(GoalDto goal)
    {
        scheduleGoal  = goal;
        scheduleError = null;
        savingSchedule = false;

        var remaining  = Math.Max(0m, goal.TargetAmount - goal.SavedAmount);
        var today      = DateTime.Today;
        var nextMonth  = today.Month == 12 ? new DateTime(today.Year + 1, 1, 1) : new DateTime(today.Year, today.Month + 1, 1);
        var endDate    = new DateOnly(goal.TargetDate.Year, goal.TargetDate.Month, 1);
        var startDate  = new DateOnly(nextMonth.Year, nextMonth.Month, 1);
        if (endDate < startDate) endDate = startDate;

        int months = (endDate.Year - startDate.Year) * 12 + (endDate.Month - startDate.Month) + 1;
        var monthly = months > 0 ? Math.Ceiling(remaining / months * 100) / 100 : remaining;

        scheduleDto = new GenerateGoalScheduleDto
        {
            GoalId          = goal.Id,
            FromAccountId   = goal.SourceAccountId,
            ToAccountId     = goal.TargetAccountId,
            MonthlyAmount   = monthly,
            StartYear       = startDate.Year,
            StartMonth      = startDate.Month,
            EndYear         = endDate.Year,
            EndMonth        = endDate.Month,
            ReplaceExisting = true,
        };
        showScheduleModal = true;
    }

    private void CloseScheduleModal() => showScheduleModal = false;

    private void ParseMonthInput(string? val, bool isStart)
    {
        // val is "YYYY-MM" from <input type="month">
        if (val is null || val.Length < 7) return;
        if (!int.TryParse(val[..4], out var yr) || !int.TryParse(val[5..7], out var mo)) return;
        if (isStart) { scheduleDto.StartYear = yr; scheduleDto.StartMonth = mo; }
        else          { scheduleDto.EndYear   = yr; scheduleDto.EndMonth   = mo; }
    }

    private async Task SaveSchedule()
    {
        if (string.IsNullOrEmpty(userId) || scheduleGoal is null) return;
        scheduleError  = null;
        savingSchedule = true;
        try
        {
            await PlanService.GenerateGoalScheduleAsync(userId, scheduleDto);
            showScheduleModal = false;
        }
        catch (Exception ex)
        {
            scheduleError = ex.Message;
        }
        finally
        {
            savingSchedule = false;
        }
    }
}
