@page "/flows"
@attribute [Authorize]
@inject IActualFlowService FlowService
@inject IAccountService AccountService
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Transactions — PlanToSave</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Transactions</h1>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" @onclick="OpenAccountModal">+ New Account</button>
        <a href="/flows/import" class="btn btn-outline-primary">Import CSV</a>
        <a href="/flows/new" class="btn btn-primary">+ Log Transaction</a>
    </div>
</div>

@if (showAccountModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">New Account or Category</h5>
                    <button type="button" class="btn-close" @onclick="CloseAccountModal"></button>
                </div>
                <EditForm Model="newAccount" OnValidSubmit="SaveNewAccount">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Account Name</label>
                            <InputText @bind-Value="newAccount.Name" class="form-control" placeholder="e.g. Main Checking" />
                            <ValidationMessage For="() => newAccount.Name" class="text-danger small" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Account Type</label>
                            <InputSelect @bind-Value="newAccount.Type" class="form-select">
                                @foreach (var t in Enum.GetValues<AccountType>())
                                {
                                    <option value="@t">@t</option>
                                }
                            </InputSelect>
                            <div class="form-text text-muted">@GetAccountTypeHint(newAccount.Type)</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Description <span class="fw-normal text-muted">(optional)</span>
                            </label>
                            <InputText @bind-Value="newAccount.Description" class="form-control"
                                       placeholder="e.g. Joint account at First National Bank" />
                        </div>
                        @if (newAccount.Type is AccountType.Checking or AccountType.Savings
                                             or AccountType.Credit or AccountType.Investment)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Opening Balance <span class="fw-normal text-muted">(optional)</span>
                                </label>
                                <div class="input-group" style="max-width:200px">
                                    <span class="input-group-text">$</span>
                                    <InputNumber @bind-Value="newAccount.OpeningBalance" class="form-control" step="0.01" />
                                </div>
                                <ValidationMessage For="() => newAccount.OpeningBalance" class="text-danger small" />
                            </div>
                        }
                        @if (accountSaveError is not null)
                        {
                            <div class="text-danger small">@accountSaveError</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseAccountModal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Account</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@* ── Filters ────────────────────────────────────────────────────── *@
<div class="card mb-4">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-sm-3">
                <label class="form-label small fw-semibold mb-1">From</label>
                <input type="date" class="form-control form-control-sm"
                       value="@filterFrom.ToString("yyyy-MM-dd")"
                       @onchange="e => OnFromDateChanged(e.Value?.ToString())" />
            </div>
            <div class="col-sm-3">
                <label class="form-label small fw-semibold mb-1">To</label>
                <input type="date" class="form-control form-control-sm"
                       value="@filterTo.ToString("yyyy-MM-dd")"
                       @onchange="e => OnToDateChanged(e.Value?.ToString())" />
            </div>
            <div class="col-sm-4">
                <label class="form-label small fw-semibold mb-1">Account</label>
                <select class="form-select form-select-sm" @onchange="e => OnAccountFilterChanged(e.Value?.ToString())">
                    <option value="">All accounts</option>
                    @foreach (var account in accountOptions)
                    {
                        <option value="@account.Id">@account.Name (@account.Type)</option>
                    }
                </select>
            </div>
            <div class="col-sm-2">
                <button class="btn btn-sm btn-secondary w-100" @onclick="ResetFilters">Reset</button>
            </div>
        </div>
    </div>
</div>

@* ── Flow List ───────────────────────────────────────────────────── *@
@if (flows is null)
{
    <p class="text-muted">Loading...</p>
}
else if (flows.Count == 0)
{
    <div class="card text-center py-5">
        <div class="card-body text-muted">
            <p class="mb-1 fw-semibold">No transactions found.</p>
            <p class="mb-0 small">No transactions match the selected filters.</p>
            <div class="mt-3">
                <a href="/flows/new" class="btn btn-sm btn-secondary">+ Log Transaction</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr class="small text-uppercase text-muted">
                        <th>Date</th>
                        <th>From</th>
                        <th></th>
                        <th>To</th>
                        <th class="text-end">Amount</th>
                        <th>Description</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var flow in flows)
                    {
                        var flowLabel = flow.Description ?? (flow.FromAccountName + " → " + flow.ToAccountName);
                        <tr>
                            <td class="text-nowrap text-muted small">@flow.Date.ToString("MMM d, yyyy")</td>
                            <td>
                                <span class="badge @GetTypeBadgeClass(flow.FromAccountType) me-1">@flow.FromAccountType</span>
                                @flow.FromAccountName
                            </td>
                            <td class="text-muted">→</td>
                            <td>
                                <span class="badge @GetTypeBadgeClass(flow.ToAccountType) me-1">@flow.ToAccountType</span>
                                @flow.ToAccountName
                            </td>
                            <td class="text-end fw-semibold text-success">@flow.Amount.ToString("C")</td>
                            <td class="text-muted small">@(flow.Description ?? "—")</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-danger" title="Delete" aria-label="Delete flow"
                                        @onclick="() => DeleteFlow(flow.Id, flowLabel)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                        <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                                    </svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
    <div class="text-muted small mt-2">@flows.Count flow@(flows.Count == 1 ? "" : "s") shown</div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible mt-3">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private string userId = "";
    private List<ActualFlowDto>? flows;
    private List<AccountOptionDto> accountOptions = [];
    private string? errorMessage;

    private DateOnly filterFrom = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateOnly filterTo = DateOnly.FromDateTime(DateTime.Today);
    private Guid? filterAccountId;

    // Account modal
    private bool showAccountModal = false;
    private CreateAccountDto newAccount = new();
    private string? accountSaveError;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";

        var fromOptions = await FlowService.GetFromAccountOptionsAsync(userId);
        var toOptions = await FlowService.GetToAccountOptionsAsync(userId);
        accountOptions = fromOptions.Union(toOptions).DistinctBy(a => a.Id)
                                    .OrderBy(a => a.Name).ToList();

        await LoadFlows();
    }

    private async Task LoadFlows()
    {
        flows = await FlowService.GetFlowsAsync(userId, new FlowFilterDto(filterFrom, filterTo, filterAccountId));
    }

    private async Task OnFromDateChanged(string? value)
    {
        if (DateOnly.TryParse(value, out var d)) filterFrom = d;
        await LoadFlows();
    }

    private async Task OnToDateChanged(string? value)
    {
        if (DateOnly.TryParse(value, out var d)) filterTo = d;
        await LoadFlows();
    }

    private async Task OnAccountFilterChanged(string? value)
    {
        filterAccountId = Guid.TryParse(value, out var id) ? id : null;
        await LoadFlows();
    }

    private async Task ResetFilters()
    {
        filterFrom = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1);
        filterTo = DateOnly.FromDateTime(DateTime.Today);
        filterAccountId = null;
        await LoadFlows();
    }

    private async Task DeleteFlow(Guid id, string label)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete \"{label}\"? This cannot be undone.");
        if (!confirmed) return;

        try
        {
            await FlowService.DeleteAsync(id, userId);
            await LoadFlows();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not delete flow: {ex.Message}";
        }
    }

    private static string GetTypeBadgeClass(AccountType type) => type switch
    {
        AccountType.Income     => "bg-success",
        AccountType.Expense    => "bg-danger",
        AccountType.Checking   => "bg-primary",
        AccountType.Savings    => "bg-info text-dark",
        AccountType.Credit     => "bg-warning text-dark",
        AccountType.Investment => "bg-secondary",
        _                      => "bg-light text-dark"
    };

    private void OpenAccountModal()
    {
        newAccount = new CreateAccountDto();
        accountSaveError = null;
        showAccountModal = true;
    }

    private void CloseAccountModal() => showAccountModal = false;

    private async Task SaveNewAccount()
    {
        try
        {
            await AccountService.CreateAsync(userId, newAccount);
            var fromOptions = await FlowService.GetFromAccountOptionsAsync(userId);
            var toOptions = await FlowService.GetToAccountOptionsAsync(userId);
            accountOptions = fromOptions.Union(toOptions).DistinctBy(a => a.Id)
                                        .OrderBy(a => a.Name).ToList();
            showAccountModal = false;
        }
        catch (Exception ex)
        {
            accountSaveError = ex.Message;
        }
    }

    private static string GetAccountTypeHint(AccountType type) => type switch
    {
        AccountType.Checking   => "Everyday spending account with a running balance.",
        AccountType.Savings    => "Savings account that earns interest.",
        AccountType.Credit     => "Credit card or line of credit.",
        AccountType.Investment => "Brokerage or investment account.",
        AccountType.Income     => "An income source (salary, freelance, etc.) — no balance tracked.",
        AccountType.Expense    => "A spending category (groceries, utilities, dining, etc.) — no balance tracked.",
        _                      => ""
    };
}
