@page "/"
@attribute [Authorize]
@inject IAccountService AccountService
@inject IGoalService GoalService
@inject IIdeaService IdeaService
@inject IActivityPlanService ActivityPlanService
@inject IMonthlyPlanService PlanService

<PageTitle>Dashboard — PlanToSave</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Dashboard</h1>
    <span class="text-muted">@DateTime.Now.ToString("MMMM yyyy")</span>
</div>

@if (balances is null)
{
    <p class="text-muted">Loading...</p>
}
else
{
    @* Life Loop Summary *@
    <h5 class="text-muted text-uppercase small fw-semibold mb-3">Your Life Plan</h5>
    <div class="row g-3 mb-3">
        <div class="col-4">
            <div class="card h-100">
                <div class="card-body text-center py-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="text-warning d-block mx-auto mb-1" viewBox="0 0 16 16">
                        <path d="M2 6a6 6 0 1 1 10.174 4.31c-.203.196-.359.4-.453.619l-.762 1.769A.5.5 0 0 1 10.5 13a.5.5 0 0 1 0 1 .5.5 0 0 1 0 1l-.224.447a1 1 0 0 1-.894.553H6.618a1 1 0 0 1-.894-.553L5.5 15a.5.5 0 0 1 0-1 .5.5 0 0 1 0-1 .5.5 0 0 1-.46-.302l-.761-1.77a1.964 1.964 0 0 0-.453-.618A5.984 5.984 0 0 1 2 6zm6-5a5 5 0 0 0-3.479 8.592c.263.254.514.564.676.941L5.83 12h4.342l.632-1.467c.162-.377.413-.687.676-.941A5 5 0 0 0 8 1z"/>
                    </svg>
                    <div class="fs-3 fw-bold">@BacklogCount</div>
                    <div class="text-muted small">Ideas in backlog</div>
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="card h-100">
                <div class="card-body text-center py-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="text-primary d-block mx-auto mb-1" viewBox="0 0 16 16">
                        <path d="M14 0H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zM1 3.857C1 3.384 1.448 3 2 3h12c.552 0 1 .384 1 .857v10.286c0 .473-.448.857-1 .857H2c-.552 0-1-.384-1-.857V3.857z"/>
                        <path d="M6.5 7a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
                    </svg>
                    <div class="fs-3 fw-bold">@PlannedCount</div>
                    <div class="text-muted small">Planned activities</div>
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="card h-100">
                <div class="card-body text-center py-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="text-success d-block mx-auto mb-1" viewBox="0 0 16 16">
                        <path d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425a.247.247 0 0 1 .02-.022z"/>
                    </svg>
                    <div class="fs-3 fw-bold">@DoneCount</div>
                    <div class="text-muted small">Completed</div>
                </div>
            </div>
        </div>
    </div>
    <div class="mb-3 text-end">
        <a href="/ideas" class="text-muted small">Manage ideas →</a>
    </div>

    @* Coming up + Needs attention *@
    var today2 = DateOnly.FromDateTime(DateTime.Today);
    var nextWeek = today2.AddDays(7);
    var comingUp = upcomingPlans
        .Where(p => p.PlannedDate.HasValue && p.PlannedDate.Value >= today2 && p.PlannedDate.Value <= nextWeek)
        .ToList();
    var overdue = upcomingPlans
        .Where(p => p.PlannedDate.HasValue && p.PlannedDate.Value < today2)
        .ToList();
    <div class="row g-3 mb-4">
        <div class="col-md-7">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center py-2">
                    <span class="fw-semibold small">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="me-1" viewBox="0 0 16 16">
                            <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                        </svg>
                        Coming up this week
                    </span>
                    <a href="/upcoming" class="btn btn-link btn-sm p-0">See all</a>
                </div>
                <div class="card-body py-2">
                    @if (comingUp.Count == 0)
                    {
                        <p class="text-muted small mb-0">Nothing scheduled for the next 7 days.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var p in comingUp)
                            {
                                <li class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                    <a href="/upcoming/@p.Id" class="text-decoration-none fw-semibold small">@p.IdeaTitle</a>
                                    <span class="text-muted small">@p.PlannedDate!.Value.ToString("MMM d")</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="card h-100 @(overdue.Count > 0 ? "border-warning" : "")">
                <div class="card-header d-flex justify-content-between align-items-center py-2">
                    <span class="fw-semibold small @(overdue.Count > 0 ? "text-warning" : "")">
                        @(overdue.Count > 0 ? "⚠️ Needs review" : "All caught up")
                    </span>
                    @if (overdue.Count > 0)
                    {
                        <a href="/upcoming" class="btn btn-link btn-sm p-0">Go to plans</a>
                    }
                </div>
                <div class="card-body py-2">
                    @if (overdue.Count == 0)
                    {
                        <p class="text-muted small mb-0">No overdue plans.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var p in overdue)
                            {
                                <li class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                    <a href="/upcoming/@p.Id" class="text-decoration-none fw-semibold small">@p.IdeaTitle</a>
                                    <span class="text-danger small">@p.PlannedDate!.Value.ToString("MMM d, yyyy")</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    @if (balances.Count == 0)
    {
        <div class="alert alert-info mt-2">
            <strong>Welcome to PlanToSave!</strong> Set up your accounts to see your balances here.
            <a href="/accounts/new" class="alert-link ms-1">Add your first account →</a>
        </div>
    }
    else
    {
        @* Net Worth Summary *@
        var netWorth = balances.Sum(b => b.Balance);
        <div class="card mb-4 border-0 bg-dark text-white">
            <div class="card-body py-3">
                <div class="small text-white-50 text-uppercase fw-semibold mb-1">Net Worth</div>
                <div class="fs-2 fw-bold @(netWorth >= 0 ? "" : "text-danger")">
                    @FormatCurrency(netWorth)
                </div>
            </div>
        </div>

        @* This Month Summary *@
        <h5 class="text-muted text-uppercase small fw-semibold mb-3">This Month</h5>
        @if (currentPlan is not null)
        {
            var planned = currentPlan.PlannedFlows.Sum(f => f.PlannedAmount);
            var actual  = currentPlan.PlannedFlows.Sum(f => f.ActualAmount);
            var variance = actual - planned;
            var varClass = variance >= 0 ? "text-success" : "text-danger";
            var varSign  = variance >= 0 ? "+" : "";
            <div class="row g-3 mb-4">
                <div class="col-4">
                    <div class="card text-center h-100 py-2">
                        <div class="text-muted small mb-1">Planned</div>
                        <div class="fs-5 fw-bold">@FormatCurrency(planned)</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="card text-center h-100 py-2">
                        <div class="text-muted small mb-1">Actual</div>
                        <div class="fs-5 fw-bold">@FormatCurrency(actual)</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="card text-center h-100 py-2">
                        <div class="text-muted small mb-1">Variance</div>
                        <div class="fs-5 fw-bold @varClass">@(varSign + FormatCurrency(variance))</div>
                    </div>
                </div>
            </div>
            <div class="mb-4 text-end">
                <a href="/plans/@DateTime.Today.Year/@DateTime.Today.Month" class="text-muted small">
                    View @DateTime.Today.ToString("MMMM") plan →
                </a>
            </div>
        }
        else
        {
            <div class="card mb-4 text-center py-3 text-muted small">
                No plan for this month yet.
                <a href="/plans/@DateTime.Today.Year/@DateTime.Today.Month" class="ms-1">Create one →</a>
            </div>
        }

        @* Account Balances *@
        <h5 class="text-muted text-uppercase small fw-semibold mb-3">Account Balances</h5>
        <div class="row g-3 mb-4">
            @foreach (var b in balances)
            {
                <div class="col-sm-6 col-lg-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="fw-semibold">@b.Name</span>
                                <span class="badge @GetTypeBadgeClass(b.Type) ms-2">@b.Type</span>
                            </div>
                            <div class="fs-4 fw-bold @GetBalanceClass(b.Balance)">
                                @FormatCurrency(b.Balance)
                            </div>
                            @if (b.AccruedInterest != 0)
                            {
                                var interestClass = b.AccruedInterest > 0 ? "text-success" : "text-danger";
                                var interestSign  = b.AccruedInterest > 0 ? "+" : "";
                                <div class="small @interestClass mt-1" title="Estimated accrued interest since last baseline">
                                    ~@(interestSign)@FormatCurrency(b.AccruedInterest) interest accruing
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="mb-4 text-end">
            <a href="/accounts" class="text-muted small">Manage accounts →</a>
        </div>
    }

    @* Active Goals *@
    @if (activeGoals.Count > 0)
    {
        <h5 class="text-muted text-uppercase small fw-semibold mb-3">Active Goals</h5>
        <div class="row g-3 mb-4">
            @foreach (var goal in activeGoals)
            {
                var pct = goal.TargetAmount > 0
                    ? Math.Min(100, (int)Math.Round(goal.SavedAmount / goal.TargetAmount * 100))
                    : 0;
                var today = DateOnly.FromDateTime(DateTime.Today);
                var daysLeft = goal.TargetDate.DayNumber - today.DayNumber;
                var barClass = pct >= 100 ? "bg-success" : (daysLeft < 30 ? "bg-warning" : "bg-primary");
                <div class="col-sm-6 col-lg-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-semibold">@goal.Name</span>
                                <span class="text-muted small">@pct%</span>
                            </div>
                            <div class="progress mb-2" style="height:10px;">
                                <div class="progress-bar @barClass" style="width:@pct%"
                                     role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <div class="d-flex justify-content-between text-muted small">
                                <span>@FormatCurrency(goal.SavedAmount) / @FormatCurrency(goal.TargetAmount)</span>
                                <span class="@(daysLeft < 0 ? "text-danger" : daysLeft < 30 ? "text-warning" : "")">
                                    @(daysLeft < 0 ? Math.Abs(daysLeft) + "d overdue" : daysLeft + "d left")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="mb-4 text-end">
            <a href="/goals" class="text-muted small">View all goals →</a>
        </div>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private List<AccountBalanceDto>? balances;
    private List<GoalDto> activeGoals = [];
    private List<IdeaDto> allIdeas = [];
    private List<ActivityPlanDto> upcomingPlans = [];
    private MonthlyPlanDetailDto? currentPlan;

    private int BacklogCount => allIdeas.Count(i => i.Status == IdeaStatus.Backlog);
    private int PlannedCount => allIdeas.Count(i => i.Status == IdeaStatus.Planned);
    private int DoneCount    => allIdeas.Count(i => i.Status == IdeaStatus.Done);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";

        balances      = await AccountService.GetBalancesAsync(userId);
        activeGoals   = (await GoalService.GetGoalsAsync(userId)).Where(g => !g.IsComplete).ToList();
        currentPlan   = await PlanService.GetPlanDetailAsync(userId, DateTime.Today.Year, DateTime.Today.Month);
        allIdeas      = await IdeaService.GetIdeasAsync(userId);
        upcomingPlans = await ActivityPlanService.GetPlansAsync(userId);
    }

    private static string FormatCurrency(decimal amount) =>
        amount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"));

    private static string GetBalanceClass(decimal balance) =>
        balance >= 0 ? "text-success" : "text-danger";

    private static string GetTypeBadgeClass(AccountType type) => type switch
    {
        AccountType.Checking   => "bg-primary",
        AccountType.Savings    => "bg-info text-dark",
        AccountType.Credit     => "bg-warning text-dark",
        AccountType.Investment => "bg-secondary",
        _                      => "bg-light text-dark"
    };
}

