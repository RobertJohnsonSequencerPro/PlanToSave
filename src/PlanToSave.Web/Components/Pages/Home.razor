@page "/"
@attribute [Authorize]
@inject IAccountService AccountService

<PageTitle>Dashboard — PlanToSave</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Dashboard</h1>
    <span class="text-muted">@DateTime.Now.ToString("MMMM yyyy")</span>
</div>

@if (balances is null)
{
    <p class="text-muted">Loading...</p>
}
else if (balances.Count == 0)
{
    <div class="alert alert-info mt-2">
        <strong>Welcome to PlanToSave!</strong> Set up your accounts to see your balances here.
        <a href="/accounts/new" class="alert-link ms-1">Add your first account →</a>
    </div>
}
else
{
    @* Net Worth Summary *@
    var netWorth = balances.Sum(b => b.Balance);
    <div class="card mb-4 border-0 bg-dark text-white">
        <div class="card-body py-3">
            <div class="small text-white-50 text-uppercase fw-semibold mb-1">Net Worth</div>
            <div class="fs-2 fw-bold @(netWorth >= 0 ? "" : "text-danger")">
                @FormatCurrency(netWorth)
            </div>
        </div>
    </div>

    @* Balance Cards *@
    <h5 class="text-muted text-uppercase small fw-semibold mb-3">Account Balances</h5>
    <div class="row g-3 mb-4">
        @foreach (var b in balances)
        {
            <div class="col-sm-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="fw-semibold">@b.Name</span>
                            <span class="badge @GetTypeBadgeClass(b.Type) ms-2">@b.Type</span>
                        </div>
                        <div class="fs-4 fw-bold @GetBalanceClass(b.Balance)">
                            @FormatCurrency(b.Balance)
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-2">
        <a href="/accounts" class="text-muted small">Manage accounts →</a>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    private List<AccountBalanceDto>? balances;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        balances = await AccountService.GetBalancesAsync(userId);
    }

    private static string FormatCurrency(decimal amount) =>
        amount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"));

    private static string GetBalanceClass(decimal balance) =>
        balance >= 0 ? "text-success" : "text-danger";

    private static string GetTypeBadgeClass(AccountType type) => type switch
    {
        AccountType.Checking   => "bg-primary",
        AccountType.Savings    => "bg-info text-dark",
        AccountType.Credit     => "bg-warning text-dark",
        AccountType.Investment => "bg-secondary",
        _                      => "bg-light text-dark"
    };
}

