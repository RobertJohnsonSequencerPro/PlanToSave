# ──────────────────────────────────────────────────────────────────────────────
# PlanToSave — Environment Configuration Reference
# Copy this file to .env for local tooling, or set these in Render's dashboard.
# NEVER commit .env or any file containing real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: standard Npgsql connection string
# ConnectionStrings__DefaultConnection=Host=localhost;Database=plantosave;Username=postgres;Password=yourpassword
#
# Render production: Render auto-injects DATABASE_URL for linked PostgreSQL.
# The app reads DATABASE_URL first, then falls back to ConnectionStrings__DefaultConnection.
DATABASE_URL=postgres://user:password@host:5432/dbname

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Add these Authorized Redirect URIs in Google Console:
#   Local dev:   https://localhost:5001/signin-google
#   Production:  https://<your-app>.onrender.com/signin-google
#
# ASP.NET Core maps Google__ClientId → configuration key "Google:ClientId"
Google__ClientId=your-google-client-id.apps.googleusercontent.com
Google__ClientSecret=your-google-client-secret

# ── ASP.NET Core ──────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production

# ── Local Dev Quick-Start ─────────────────────────────────────────────────────
# 1. Install PostgreSQL locally and create a database:
#      createdb plantosave
# 2. Set connection string via user secrets (keeps secrets out of source control):
#      cd src/PlanToSave.Web
#      dotnet user-secrets set "ConnectionStrings:DefaultConnection" \
#        "Host=localhost;Database=plantosave;Username=postgres;Password=yourpassword"
#      dotnet user-secrets set "Google:ClientId"     "your-client-id"
#      dotnet user-secrets set "Google:ClientSecret" "your-client-secret"
# 3. The app applies EF migrations automatically on startup.
# 4. dotnet run --project src/PlanToSave.Web
